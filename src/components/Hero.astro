---
---

<section class="relative overflow-hidden bg-gradient-to-b from-neutral-50 via-white to-white">
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#f1f5f9_1px,transparent_1px),linear-gradient(to_bottom,#f1f5f9_1px,transparent_1px)] bg-[size:4.5rem_4.5rem] [mask-image:radial-gradient(ellipse_70%_50%_at_50%_0%,#000_25%,transparent_65%)]"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24 md:pt-32 lg:pt-40 pb-12 sm:pb-16 md:pb-20 lg:pb-24">
    <div class="max-w-3xl mx-auto text-center lg:text-left lg:mx-0">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50/80 border border-brand-200/60 text-brand-700 text-xs sm:text-sm font-medium backdrop-blur-sm mb-6 sm:mb-8">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
        </span>
        Open Source &bull; Non-Profit &bull; Independen
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold text-neutral-900 leading-[1.08] tracking-tight text-balance">
        Infrastruktur riset terbuka
        <br class="hidden sm:block" />
        untuk
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 via-brand-500 to-brand-400">semua disiplin ilmu</span>
      </h1>

      <p class="mt-5 sm:mt-6 text-base sm:text-lg text-neutral-600 leading-relaxed max-w-xl mx-auto lg:mx-0 text-pretty">
        OpenRiset membangun standar, perangkat lunak, dan ekosistem publikasi ilmiah yang dapat digunakan oleh universitas, lembaga riset, sekolah, dan peneliti independen — tanpa terikat institusi, disiplin, atau vendor manapun.
      </p>

      <div class="mt-7 sm:mt-9 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start">
        <a href="#mengapa" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-neutral-900 text-white font-semibold text-sm sm:text-base hover:bg-neutral-800 transition-colors shadow-lg shadow-neutral-900/10">
          Mengapa OpenRiset
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        </a>
        <a href="https://github.com/openriset" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-neutral-300 bg-white text-neutral-700 font-semibold text-sm sm:text-base hover:bg-neutral-50 hover:border-neutral-400 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </div>

    <!-- Stats -->
    <div class="mt-12 sm:mt-16 lg:mt-20 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-6 max-w-2xl mx-auto lg:mx-0">
      <div class="text-center lg:text-left">
        <div class="text-2xl sm:text-3xl font-bold text-brand-600 tracking-tight">MIT</div>
        <div class="text-[11px] sm:text-xs text-neutral-500 mt-0.5 font-medium">Lisensi Terbuka</div>
      </div>
      <div class="text-center lg:text-left">
        <div class="text-2xl sm:text-3xl font-bold text-brand-600 tracking-tight">100%</div>
        <div class="text-[11px] sm:text-xs text-neutral-500 mt-0.5 font-medium">Open Source</div>
      </div>
      <div class="text-center lg:text-left">
        <div class="text-2xl sm:text-3xl font-bold text-brand-600 tracking-tight">Nol</div>
        <div class="text-[11px] sm:text-xs text-neutral-500 mt-0.5 font-medium">Biaya Akses</div>
      </div>
      <div class="text-center lg:text-left">
        <div class="text-2xl sm:text-3xl font-bold text-brand-600 tracking-tight">Semua</div>
        <div class="text-[11px] sm:text-xs text-neutral-500 mt-0.5 font-medium">Disiplin Ilmu</div>
      </div>
    </div>
  </div>
</section>
