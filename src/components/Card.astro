---
interface Props {
  title: string;
  description: string;
  icon?: string;
  href?: string;
}

const { title, description, icon, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  {href}
  class="block group p-5 sm:p-6 rounded-xl border border-neutral-200/80 bg-white transition-all duration-300 ease-out hover:border-brand-200 hover:shadow-[0_4px_24px_-4px_rgba(59,130,246,0.12)] active:scale-[0.985]"
  target={href ? "_blank" : undefined}
  rel={href ? "noopener" : undefined}
>
  {icon && (
    <span class="inline-flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-brand-50 text-lg sm:text-xl mb-3 sm:mb-4">
      {icon}
    </span>
  )}
  <h3 class="text-sm sm:text-base font-semibold text-neutral-900 leading-snug">
    {title}
  </h3>
  <p class="mt-1.5 text-xs sm:text-sm text-neutral-500 leading-relaxed">
    {description}
  </p>
  {href && (
    <span class="inline-flex items-center gap-1.5 mt-3 sm:mt-4 text-xs sm:text-sm font-medium text-brand-600 group-hover:text-brand-700 transition-colors">
      <span>Selengkapnya</span>
      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </span>
  )}
</Tag>
