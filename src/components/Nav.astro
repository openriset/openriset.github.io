---
---

<header class="sticky top-0 z-50 w-full py-3 px-4 sm:px-6 transition-all duration-500 ease-in-out bg-transparent" id="site-header">
  <div class="max-w-7xl mx-auto bg-transparent border border-transparent rounded-2xl px-4 sm:px-6 transition-all duration-500 ease-in-out shadow-none" id="nav-container">
    <nav class="w-full flex items-center justify-between h-14 sm:h-16 transition-all duration-500" id="inner-nav">
      <a href="/" class="flex items-center gap-2 group shrink-0" aria-label="OpenRiset Home">
        <div class="relative w-8 h-8 flex items-center justify-center bg-brand-50 rounded-xl group-hover:bg-brand-100 transition-colors duration-300">
          <svg class="w-5 h-5 text-brand-600 group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 22h20L12 2z" />
            <circle cx="12" cy="6" r="2.5" fill="currentColor" />
            <circle cx="5" cy="18" r="2.5" fill="currentColor" />
            <circle cx="19" cy="18" r="2.5" fill="currentColor" />
          </svg>
        </div>
        <span class="font-bold text-ink text-base sm:text-lg tracking-tight font-display">OpenRiset</span>
      </a>

      <div class="hidden md:flex items-center gap-7 text-[13px] lg:text-sm font-medium text-neutral-500">
        <a href="#why" class="link-underline hover:text-ink">Mengapa</a>
        <a href="#projects" class="link-underline hover:text-ink">Proyek</a>
        <a href="#standards" class="link-underline hover:text-ink">Standar</a>
        <a href="#vision" class="link-underline hover:text-ink">Visi</a>
        <a href="#audience" class="link-underline hover:text-ink">Pengguna</a>
        <a href="https://github.com/openriset" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-ink text-white text-xs lg:text-sm font-medium hover:bg-brand-700 transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>

      <button class="md:hidden flex items-center justify-center w-11 h-11 rounded-xl hover:bg-neutral-100 transition-colors -mr-2" id="menu-btn" type="button" aria-label="Toggle menu">
        <svg class="w-5 h-5 text-ink" id="menu-open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg class="w-5 h-5 text-ink hidden" id="menu-close" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </nav>
    <div id="mobile-menu" class="md:hidden border-t border-neutral-100/40 mobile-menu-content">
      <div class="px-2 py-1 space-y-1">
        <a href="#why" class="mobile-nav-link block px-4 py-3 rounded-xl text-sm font-medium text-neutral-600 hover:bg-neutral-50 hover:text-ink transition-all duration-200">Mengapa OpenRiset</a>
        <a href="#projects" class="mobile-nav-link block px-4 py-3 rounded-xl text-sm font-medium text-neutral-600 hover:bg-neutral-50 hover:text-ink transition-all duration-200">Proyek</a>
        <a href="#standards" class="mobile-nav-link block px-4 py-3 rounded-xl text-sm font-medium text-neutral-600 hover:bg-neutral-50 hover:text-ink transition-all duration-200">Standar</a>
        <a href="#vision" class="mobile-nav-link block px-4 py-3 rounded-xl text-sm font-medium text-neutral-600 hover:bg-neutral-50 hover:text-ink transition-all duration-200">Visi & Misi</a>
        <a href="#audience" class="mobile-nav-link block px-4 py-3 rounded-xl text-sm font-medium text-neutral-600 hover:bg-neutral-50 hover:text-ink transition-all duration-200">Pengguna</a>
        <a href="https://github.com/openriset" target="_blank" rel="noopener" class="block px-4 py-3 rounded-xl text-sm font-semibold bg-ink text-white hover:bg-brand-700 text-center mt-2 transition-colors duration-200">GitHub</a>
      </div>
    </div>
  </div>
</header>

<script>
  const container = document.getElementById('nav-container');
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-open');
  const iconClose = document.getElementById('menu-close');

  let menuOpen = false;

  const updateHeaderState = () => {
    const isScrolled = window.scrollY > 20;
    const shouldBeOpaque = isScrolled || menuOpen;
    
    if (shouldBeOpaque) {
      container?.classList.remove('max-w-7xl', 'bg-transparent', 'border-transparent', 'shadow-none');
      container?.classList.add('max-w-5xl', 'bg-white/80', 'backdrop-blur-md', 'border-neutral-200/40', 'shadow-[0_12px_30px_-10px_rgba(0,0,0,0.06)]');
    } else {
      container?.classList.add('max-w-7xl', 'bg-transparent', 'border-transparent', 'shadow-none');
      container?.classList.remove('max-w-5xl', 'bg-white/80', 'backdrop-blur-md', 'border-neutral-200/40', 'shadow-[0_12px_30px_-10px_rgba(0,0,0,0.06)]');
    }
  };

  const navLinks = document.querySelectorAll('#inner-nav a[href^="#"]');
  const mobileLinks = document.querySelectorAll('#mobile-menu a[href^="#"]');
  
  const clearActiveLinks = () => {
    navLinks.forEach(link => link.classList.remove('active'));
    mobileLinks.forEach(link => link.classList.remove('active'));
  };

  const sectionsConfig = [
    { id: 'why', navId: 'why' },
    { id: 'products', navId: 'why' },
    { id: 'projects', navId: 'projects' },
    { id: 'standards', navId: 'standards' },
    { id: 'vision', navId: 'vision' },
    { id: 'audience', navId: 'audience' }
  ];

  const updateActiveLink = () => {
    if (window.scrollY < 80) {
      clearActiveLinks();
      return;
    }

    const targetLine = 160; // px from top of viewport
    let activeNavId = null;

    // Find if any configured section spans across the target line
    for (const section of sectionsConfig) {
      const el = document.getElementById(section.id);
      if (el) {
        const rect = el.getBoundingClientRect();
        if (rect.top <= targetLine && rect.bottom >= targetLine) {
          activeNavId = section.navId;
          break;
        }
      }
    }

    // Fallback: If no section spans the line, find the closest one
    if (!activeNavId) {
      let minDistance = Infinity;
      for (const section of sectionsConfig) {
        const el = document.getElementById(section.id);
        if (el) {
          const rect = el.getBoundingClientRect();
          const distance = Math.abs(rect.top - targetLine);
          if (distance < minDistance) {
            minDistance = distance;
            activeNavId = section.navId;
          }
        }
      }
    }

    // Highlight active link, remove from others
    navLinks.forEach(link => {
      link.classList.toggle('active', link.getAttribute('href') === `#${activeNavId}`);
    });
    mobileLinks.forEach(link => {
      link.classList.toggle('active', link.getAttribute('href') === `#${activeNavId}`);
    });
  };

  let scrollTimeout: number | undefined;
  window.addEventListener('scroll', () => {
    updateHeaderState();
    
    if (scrollTimeout) {
      window.cancelAnimationFrame(scrollTimeout);
    }
    
    scrollTimeout = window.requestAnimationFrame(() => {
      updateActiveLink();
    });
  }, { passive: true });

  // Initial check on mount
  updateHeaderState();
  updateActiveLink();

  btn?.addEventListener('click', () => {
    menuOpen = menu?.classList.toggle('expanded') === true;
    iconOpen?.classList.toggle('hidden', menuOpen);
    iconClose?.classList.toggle('hidden', !menuOpen);
    updateHeaderState();
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.remove('expanded');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuOpen = false;
      updateHeaderState();
    });
  });
</script>

<style>
  .mobile-menu-content {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }
  .mobile-menu-content.expanded {
    max-height: 400px;
    opacity: 1;
    padding-bottom: 1.25rem;
    padding-top: 0.75rem;
  }
</style>
