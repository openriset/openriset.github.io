---
---

<header class="sticky top-0 z-50 bg-white/75 backdrop-blur-xl border-b border-transparent transition-colors duration-500" id="site-header">
  <nav class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 h-14 sm:h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="OpenRiset Home">
      <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-ink flex items-center justify-center text-brand-400 text-xs sm:text-sm font-extrabold group-hover:bg-brand-600 group-hover:text-white transition-colors duration-300">O</span>
      <span class="font-bold text-ink text-base sm:text-lg tracking-tight">OpenRiset</span>
    </a>

    <div class="hidden md:flex items-center gap-7 text-[13px] lg:text-sm font-medium text-neutral-500">
      <a href="#why" class="link-underline hover:text-ink">Mengapa</a>
      <a href="#vision" class="link-underline hover:text-ink">Visi</a>
      <a href="#projects" class="link-underline hover:text-ink">Proyek</a>
      <a href="#standards" class="link-underline hover:text-ink">Standar</a>
      <a href="#audience" class="link-underline hover:text-ink">Pengguna</a>
      <a href="https://github.com/openriset" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-ink text-white text-xs lg:text-sm font-medium hover:bg-brand-700 transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        GitHub
      </a>
    </div>

    <button class="md:hidden flex items-center justify-center w-9 h-9 rounded-lg hover:bg-neutral-100 transition-colors -mr-1.5" id="menu-btn" type="button" aria-label="Toggle menu">
      <svg class="w-5 h-5 text-ink" id="menu-open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg class="w-5 h-5 text-ink hidden" id="menu-close" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-100 bg-white/95 backdrop-blur-xl">
    <div class="px-5 py-3 space-y-0.5">
      <a href="#why" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-600 hover:bg-neutral-50 hover:text-ink">Mengapa OpenRiset</a>
      <a href="#vision" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-600 hover:bg-neutral-50 hover:text-ink">Visi & Misi</a>
      <a href="#projects" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-600 hover:bg-neutral-50 hover:text-ink">Proyek</a>
      <a href="#standards" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-600 hover:bg-neutral-50 hover:text-ink">Standar</a>
      <a href="#audience" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-600 hover:bg-neutral-50 hover:text-ink">Pengguna</a>
      <a href="https://github.com/openriset" target="_blank" rel="noopener" class="block px-3 py-2.5 rounded-lg text-sm font-semibold bg-ink text-white hover:bg-brand-700 text-center mt-1.5">GitHub</a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-open');
  const iconClose = document.getElementById('menu-close');

  let scrolled = false;
  window.addEventListener('scroll', () => {
    const now = window.scrollY > 0;
    if (now !== scrolled) {
      scrolled = now;
      header?.classList.toggle('border-neutral-200/60', now);
      header?.classList.toggle('shadow-sm', now);
    }
  }, { passive: true });

  btn?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !hidden);
    iconClose?.classList.toggle('hidden', hidden);
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
