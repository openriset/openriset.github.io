---
const sections = [
  { id: 'mengapa', label: 'Mengapa' },
  { id: 'visi', label: 'Visi' },
  { id: 'proyek', label: 'Proyek' },
  { id: 'siapa', label: 'Pengguna' },
  { id: 'standar', label: 'Standar' },
  { id: 'kontribusi', label: 'Kontribusi' },
  { id: 'faq', label: 'FAQ' },
];
---

<nav class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white/90 backdrop-blur-xl border-t border-neutral-200/60 shadow-[0_-8px_32px_-8px_rgba(0,0,0,0.06)]" id="mobile-toc" style="padding-bottom: env(safe-area-inset-bottom, 0px);">
  <div class="flex items-center overflow-x-auto scrollbar-none px-1 py-0.5" id="toc-scroll">
    {sections.map(({ id, label }) => (
      <a
        href={`#${id}`}
        class="toc-link shrink-0 px-3 py-2.5 text-[11px] font-semibold text-neutral-500 hover:text-neutral-900 whitespace-nowrap transition-colors"
      >
        {label}
      </a>
    ))}
    <!-- Divider -->
    <span class="w-px h-4 bg-neutral-200 shrink-0 mx-0.5"></span>
    <a
      href="#top"
      class="toc-link shrink-0 px-3 py-2.5 text-[11px] font-semibold text-neutral-400 hover:text-neutral-900 whitespace-nowrap transition-colors"
      aria-label="Back to top"
    >
      ↑ Top
    </a>
  </div>
</nav>

<div class="md:hidden h-11" aria-hidden="true"></div>

<style>
  .scrollbar-none {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scrollbar-none::-webkit-scrollbar { display: none; }
</style>

<script>
  const links = document.querySelectorAll('.toc-link');
  const sects = document.querySelectorAll('section[id]');

  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        links.forEach(l => {
          const active = l.getAttribute('href') === `#${e.target.id}`;
          l.classList.toggle('text-neutral-900', active);
          l.classList.toggle('text-neutral-500', !active);
        });
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });

  sects.forEach(s => obs.observe(s));
</script>
