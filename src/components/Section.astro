---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<section {id} class="py-16 sm:py-20 lg:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-or-slate-900 leading-tight tracking-tight">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-4 text-base sm:text-lg text-or-slate-500 leading-relaxed max-w-2xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>
    <slot />
  </div>
</section>
