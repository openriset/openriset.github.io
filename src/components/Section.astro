---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  /** Collapsed by default on mobile. Desktop always open. */
  collapsed?: boolean;
}

const { id, title, subtitle, collapsed = false } = Astro.props;
---

<section {id} class="py-8 sm:py-12 md:py-16 lg:py-20 border-b border-or-slate-100 last:border-b-0">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header — clickable toggle on mobile -->
    <button
      type="button"
      class="section-toggle w-full text-left flex items-start justify-between gap-2 mb-4 sm:mb-6 md:mb-8 lg:mb-10 md:cursor-default"
      aria-expanded={collapsed ? "false" : "true"}
    >
      <div class="flex-1 min-w-0">
        <h2 class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold text-or-slate-900 leading-tight tracking-tight">
          {title}
        </h2>
        {subtitle && (
          <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm md:text-base lg:text-lg text-or-slate-500 leading-relaxed max-w-2xl">
            {subtitle}
          </p>
        )}
      </div>
      <!-- Toggle icon — hidden on desktop -->
      <span class="toggle-icon shrink-0 mt-1.5 sm:mt-2 text-or-slate-400 transition-transform duration-300 md:hidden {collapsed ? '' : 'rotate-180'}">
        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
      </span>
    </button>

    <!-- Content wrapper -->
    <div class="section-content {collapsed ? '' : 'expanded'}">
      <slot />
    </div>
  </div>
</section>

<style>
  /* Mobile: collapsible with smooth animation */
  @media (max-width: 767px) {
    .section-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
      opacity: 0;
    }
    .section-content.expanded {
      max-height: 9999px;
      opacity: 1;
    }
    .section-toggle {
      cursor: pointer;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }
    .section-toggle:active {
      background: transparent;
    }
  }

  /* Desktop: always show full content */
  @media (min-width: 768px) {
    .section-content {
      max-height: none !important;
      overflow: visible !important;
      opacity: 1 !important;
    }
  }
</style>
