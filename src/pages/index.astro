---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const TITLE = "OpenRiset — Infrastruktur Sains Terbuka untuk Indonesia";
const DESC = "OpenRiset membangun standar, perangkat lunak, dan ekosistem publikasi ilmiah terbuka untuk semua disiplin ilmu.";
---

<Layout title={TITLE} description={DESC}>
  <div id="top"></div>
  <Nav />

  <main>
    <!-- ═══════════ HERO ═══════════ -->
    <section class="relative overflow-hidden pt-20 sm:pt-28 lg:pt-36 pb-16 sm:pb-20 lg:pb-24">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_10%,rgba(37,99,235,0.06),transparent)]"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-brand-100/40 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>

      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <div class="max-w-3xl">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-ink leading-[1.06] tracking-tight text-balance">
            <span class="block reveal">Infrastruktur riset</span>
            <span class="block reveal" style="animation-delay: 0.1s">untuk Indonesia.</span>
            <span class="block reveal text-neutral-400 font-semibold text-2xl sm:text-3xl md:text-4xl lg:text-5xl mt-2 sm:mt-3" style="animation-delay: 0.2s">
              Terbuka. Independen.<br class="sm:hidden" /> Untuk semua.
            </span>
          </h1>

          <p class="mt-6 sm:mt-8 text-base sm:text-lg text-neutral-500 leading-relaxed max-w-lg reveal text-pretty" style="animation-delay: 0.3s">
            Kami membangun fondasi teknis untuk publikasi ilmiah yang bisa dipakai siapa saja — universitas, sekolah, lembaga riset, atau peneliti independen. Tanpa terikat vendor. Tanpa biaya.
          </p>

          <div class="mt-7 sm:mt-9 flex flex-col sm:flex-row gap-3 sm:gap-4 reveal" style="animation-delay: 0.4s">
            <a href="#why" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-ink text-white font-semibold text-sm hover:bg-brand-700 transition-colors shadow-xl shadow-ink/10 group">
              Kenapa ini penting
              <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
            </a>
            <a href="#projects" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-neutral-200 bg-white text-neutral-600 font-semibold text-sm hover:border-neutral-300 hover:text-ink transition-colors group">
              Lihat proyek
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <div class="mt-14 sm:mt-18 lg:mt-22 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-6 max-w-xl reveal-slow" style="animation-delay: 0.5s">
          <div class="border-l-2 border-brand-200 pl-4">
            <span class="text-xl sm:text-2xl font-bold text-ink">MIT</span>
            <span class="block text-[11px] sm:text-xs text-neutral-400 mt-0.5">Lisensi</span>
          </div>
          <div class="border-l-2 border-brand-200 pl-4">
            <span class="text-xl sm:text-2xl font-bold text-ink">100%</span>
            <span class="block text-[11px] sm:text-xs text-neutral-400 mt-0.5">Open source</span>
          </div>
          <div class="border-l-2 border-brand-200 pl-4">
            <span class="text-xl sm:text-2xl font-bold text-ink">Rp0</span>
            <span class="block text-[11px] sm:text-xs text-neutral-400 mt-0.5">Biaya</span>
          </div>
          <div class="border-l-2 border-brand-200 pl-4">
            <span class="text-xl sm:text-2xl font-bold text-ink">Semua</span>
            <span class="block text-[11px] sm:text-xs text-neutral-400 mt-0.5">Disiplin</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ WHY ═══════════ -->
    <section id="why" class="py-14 sm:py-20 lg:py-28 section-collapsible bg-soft">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <div class="max-w-2xl mb-12 sm:mb-16 reveal">
          <span class="text-brand-600 text-xs font-semibold uppercase tracking-widest">Masalah</span>
          <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold text-ink leading-[1.15] tracking-tight">
            Riset Indonesia butuh fondasi, <br class="hidden sm:block">bukan platform tertutup
          </h2>
        </div>

        <div class="section-body expanded space-y-12 sm:space-y-20">
          <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-center reveal">
            <div class="lg:col-span-3">
              <p class="text-brand-600 text-sm font-bold mb-2">01</p>
              <h3 class="text-xl sm:text-2xl font-bold text-ink mb-3">Karya hilang. Jejak lenyap.</h3>
              <p class="text-neutral-500 leading-relaxed max-w-lg">
                Setelah lomba atau publikasi, karya siswa dan peneliti hilang begitu saja. Tidak terindeks. Tidak bisa diverifikasi. Tidak bisa disitasi. <span class="text-ink font-medium">Indonesia kehilangan jejak intelektualnya sendiri.</span>
              </p>
            </div>
            <div class="lg:col-span-2 bg-white rounded-2xl border border-neutral-100 p-6 shadow-sm">
              <div class="flex items-center gap-2 text-red-500 text-sm font-mono mb-4">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>
                Riset tidak ditemukan
              </div>
              <div class="space-y-2">
                <div class="flex items-center gap-3 p-3 bg-neutral-50 rounded-lg">
                  <span class="w-2 h-2 rounded-full bg-red-300 shrink-0"></span>
                  <span class="text-xs text-neutral-400">Laporan eksperimen fisika — hilang</span>
                </div>
                <div class="flex items-center gap-3 p-3 bg-neutral-50 rounded-lg">
                  <span class="w-2 h-2 rounded-full bg-red-300 shrink-0"></span>
                  <span class="text-xs text-neutral-400">Paper pemenang kompetisi — hilang</span>
                </div>
                <div class="flex items-center gap-3 p-3 bg-neutral-50 rounded-lg">
                  <span class="w-2 h-2 rounded-full bg-red-300 shrink-0"></span>
                  <span class="text-xs text-neutral-400">Tugas akhir terbaik — hilang</span>
                </div>
              </div>
            </div>
          </div>

          <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-center reveal">
            <div class="lg:col-span-2 order-last lg:order-first bg-white rounded-2xl border border-neutral-100 p-6 shadow-sm">
              <div class="space-y-3">
                <div class="flex items-center gap-3 p-3">
                  <svg class="w-5 h-5 text-green-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                  <span class="text-sm text-neutral-700">Format metadata yang sama</span>
                </div>
                <div class="flex items-center gap-3 p-3">
                  <svg class="w-5 h-5 text-green-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                  <span class="text-sm text-neutral-700">Kompatibel Crossref &amp; DataCite</span>
                </div>
                <div class="flex items-center gap-3 p-3">
                  <svg class="w-5 h-5 text-green-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                  <span class="text-sm text-neutral-700">Ditemukan dalam hitungan detik</span>
                </div>
              </div>
            </div>
            <div class="lg:col-span-3">
              <p class="text-brand-600 text-sm font-bold mb-2">02</p>
              <h3 class="text-xl sm:text-2xl font-bold text-ink mb-3">Setiap institusi bikin standar sendiri.</h3>
              <p class="text-neutral-500 leading-relaxed max-w-lg">
                Satu pakai format A, satunya format B. Metadata tersebar di sistem yang tidak kompatibel. <span class="text-ink font-medium">Peneliti tidak bisa membangun di atas karya sebelumnya.</span>
              </p>
            </div>
          </div>

          <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-center reveal">
            <div class="lg:col-span-3">
              <p class="text-brand-600 text-sm font-bold mb-2">03</p>
              <h3 class="text-xl sm:text-2xl font-bold text-ink mb-3">Platform yang ada dijual, bukan dibangun.</h3>
              <p class="text-neutral-500 leading-relaxed max-w-lg">
                Vendor mengunci data Anda. Biaya langganan mencekik. <span class="text-ink font-medium">Kalau infrastruktur riset itu bisnis, yang kecil akan selalu tersingkir.</span>
              </p>
            </div>
            <div class="lg:col-span-2 bg-white rounded-2xl border border-neutral-100 p-6 shadow-sm">
              <div class="flex flex-wrap gap-1.5 mb-4">
                <span class="px-2.5 py-1 bg-red-50 text-red-600 text-[11px] font-semibold rounded-md">Vendor lock-in</span>
                <span class="px-2.5 py-1 bg-red-50 text-red-600 text-[11px] font-semibold rounded-md">$5k/tahun</span>
                <span class="px-2.5 py-1 bg-red-50 text-red-600 text-[11px] font-semibold rounded-md">Data tertutup</span>
              </div>
              <div class="h-px bg-neutral-100 my-4"></div>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2.5 py-1 bg-green-50 text-green-600 text-[11px] font-semibold rounded-md">Gratis selamanya</span>
                <span class="px-2.5 py-1 bg-green-50 text-green-600 text-[11px] font-semibold rounded-md">MIT License</span>
                <span class="px-2.5 py-1 bg-green-50 text-green-600 text-[11px] font-semibold rounded-md">Data milik Anda</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ VISION ═══════════ -->
    <section id="vision" class="py-14 sm:py-20 lg:py-28 section-collapsible relative">
      <div class="absolute top-0 right-0 w-72 h-72 bg-brand-50 rounded-full blur-3xl opacity-60"></div>
      <div class="relative max-w-4xl mx-auto px-5 sm:px-8 lg:px-10">
        <div class="text-center mb-10 sm:mb-14 reveal">
          <span class="text-brand-600 text-xs font-semibold uppercase tracking-widest">Visi &amp; Misi</span>
        </div>

        <div class="section-body expanded space-y-10 sm:space-y-14">
          <blockquote class="text-center reveal">
            <p class="text-xl sm:text-2xl lg:text-3xl font-medium text-ink leading-relaxed max-w-2xl mx-auto text-balance">
              &ldquo;Setiap karya ilmiah &mdash; dari laporan eksperimen siswa SD sampai disertasi doktoral &mdash; <span class="text-brand-600">layak diindeks, diverifikasi, dan disitasi.</span>&rdquo;
            </p>
            <footer class="mt-4 text-sm text-neutral-400">— Prinsip OpenRiset</footer>
          </blockquote>

          <div class="grid sm:grid-cols-2 gap-5 sm:gap-8 reveal">
            <div class="bg-white rounded-2xl border border-neutral-100 p-6 sm:p-8 card-lift">
              <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-ink mb-2">Apa yang kami lakukan</h3>
              <p class="text-sm text-neutral-500 leading-relaxed">
                Kami menulis kode. Membuat standar. Mendokumentasikan protokol. Semuanya terbuka di GitHub, supaya <strong class="text-ink">institusi manapun bisa menjalankan platform risetnya sendiri.</strong>
              </p>
            </div>
            <div class="bg-white rounded-2xl border border-neutral-100 p-6 sm:p-8 card-lift">
              <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-ink mb-2">Apa yang kami percaya</h3>
              <p class="text-sm text-neutral-500 leading-relaxed">
                Infrastruktur riset harus <strong class="text-ink">independen</strong> &mdash; tidak di bawah institusi atau pendanaan siapapun. Harus <strong class="text-ink">terbuka</strong> &mdash; semua kode MIT. Harus <strong class="text-ink">inklusif</strong> &mdash; dari siswa SD sampai profesor.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ PROJECTS ═══════════ -->
    <section id="projects" class="py-14 sm:py-20 lg:py-28 section-collapsible bg-soft">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <div class="max-w-2xl mb-10 sm:mb-14 reveal">
          <span class="text-brand-600 text-xs font-semibold uppercase tracking-widest">Proyek</span>
          <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold text-ink leading-[1.15] tracking-tight">
            Tiga repositori. Satu fondasi.
          </h2>
        </div>

        <div class="section-body">
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 reveal">
            <a href="https://github.com/openriset/community" target="_blank" rel="noopener" class="group bg-white rounded-2xl border border-neutral-100 p-6 sm:p-8 card-lift shadow-sm">
              <span class="text-5xl sm:text-6xl font-black text-neutral-100 tracking-tighter">01</span>
              <h3 class="text-lg font-bold text-ink mt-1 group-hover:text-brand-700 transition-colors">Community</h3>
              <p class="text-sm text-neutral-500 leading-relaxed mt-2 mb-5">Monorepo utama. Semua kode sumber, shared packages, Docker config, CI/CD. Mulai dari sini.</p>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 group-hover:gap-2 transition-all">
                TypeScript <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
            <a href="https://github.com/openriset/spec" target="_blank" rel="noopener" class="group bg-white rounded-2xl border border-neutral-100 p-6 sm:p-8 card-lift shadow-sm">
              <span class="text-5xl sm:text-6xl font-black text-neutral-100 tracking-tighter">02</span>
              <h3 class="text-lg font-bold text-ink mt-1 group-hover:text-brand-700 transition-colors">Spec</h3>
              <p class="text-sm text-neutral-500 leading-relaxed mt-2 mb-5">Spesifikasi teknis, arsitektur, standar metadata, protokol verifikasi. Dokumen yang jadi acuan.</p>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 group-hover:gap-2 transition-all">
                Markdown <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
            <a href="https://github.com/openriset/citation" target="_blank" rel="noopener" class="group bg-white rounded-2xl border border-neutral-100 p-6 sm:p-8 card-lift shadow-sm sm:col-span-2 lg:col-span-1">
              <span class="text-5xl sm:text-6xl font-black text-neutral-100 tracking-tighter">03</span>
              <h3 class="text-lg font-bold text-ink mt-1 group-hover:text-brand-700 transition-colors">Citation</h3>
              <p class="text-sm text-neutral-500 leading-relaxed mt-2 mb-5">Standar dan library sitasi terbuka. Format interoperabel antar platform. Sitasi yang bisa diverifikasi.</p>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 group-hover:gap-2 transition-all">
                TypeScript <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ STANDARDS ═══════════ -->
    <section id="standards" class="py-14 sm:py-20 lg:py-28 section-collapsible">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <div class="text-center mb-10 sm:mb-14 reveal">
          <span class="text-brand-600 text-xs font-semibold uppercase tracking-widest">Standar &amp; Pendekatan</span>
          <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold text-ink leading-[1.15] tracking-tight">
            Enam prinsip. Nol kompromi.
          </h2>
        </div>

        <div class="section-body">
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 reveal">
            <div class="group text-center p-5 bg-white rounded-2xl border border-neutral-100 card-lift">
              <div class="w-10 h-10 mx-auto rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <h4 class="text-xs sm:text-sm font-bold text-ink">Metadata Standar</h4>
            </div>
            <div class="group text-center p-5 bg-white rounded-2xl border border-neutral-100 card-lift">
              <div class="w-10 h-10 mx-auto rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <h4 class="text-xs sm:text-sm font-bold text-ink">Verifikasi Bertingkat</h4>
            </div>
            <div class="group text-center p-5 bg-white rounded-2xl border border-neutral-100 card-lift">
              <div class="w-10 h-10 mx-auto rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              </div>
              <h4 class="text-xs sm:text-sm font-bold text-ink">Sitasi Terbuka</h4>
            </div>
            <div class="group text-center p-5 bg-white rounded-2xl border border-neutral-100 card-lift">
              <div class="w-10 h-10 mx-auto rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <h4 class="text-xs sm:text-sm font-bold text-ink">API Publik</h4>
            </div>
            <div class="group text-center p-5 bg-white rounded-2xl border border-neutral-100 card-lift">
              <div class="w-10 h-10 mx-auto rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <h4 class="text-xs sm:text-sm font-bold text-ink">Lisensi MIT</h4>
            </div>
            <div class="group text-center p-5 bg-white rounded-2xl border border-neutral-100 card-lift">
              <div class="w-10 h-10 mx-auto rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
              </div>
              <h4 class="text-xs sm:text-sm font-bold text-ink">Semua Jenjang</h4>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ AUDIENCE ═══════════ -->
    <section id="audience" class="py-14 sm:py-20 lg:py-28 section-collapsible bg-soft">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <div class="max-w-2xl mb-10 sm:mb-14 reveal">
          <span class="text-brand-600 text-xs font-semibold uppercase tracking-widest">Pengguna</span>
          <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold text-ink leading-[1.15] tracking-tight">
            Dibangun untuk semua yang meneliti
          </h2>
        </div>

        <div class="section-body">
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 reveal">
            <div class="group bg-white rounded-2xl border border-neutral-100 p-6 sm:p-7 card-lift shadow-sm">
              <div class="w-10 h-10 rounded-xl bg-white border border-neutral-100 flex items-center justify-center text-brand-600 mb-4 group-hover:scale-110 transition-transform duration-300 shadow-sm">
