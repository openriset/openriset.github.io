---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const TITLE = "OpenRiset — Infrastruktur Sains Terbuka untuk Indonesia";
const DESC = "OpenRiset membangun OpenRiset Index (pencatatan sitasi ramah K-12) dan OpenRiset Platform (jejaring sosial sains kredibel) untuk menyosialisasikan keterbukaan ilmiah.";
---

<Layout title={TITLE} description={DESC}>
  <div id="top"></div>
  <Nav />

  <main>
    <!-- ═══════════════════════════════════════════ HERO ═══════════════════════════════════════════ -->
    <section id="hero-section" class="relative overflow-hidden pt-12 sm:pt-20 lg:pt-28 pb-16 sm:pb-24">
      <!-- Glow spots & grid overlays -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(37,99,235,0.06),transparent)]" aria-hidden="true"></div>
      <div class="absolute top-16 right-0 w-80 sm:w-[35rem] h-80 sm:h-[35rem] bg-brand-100/30 rounded-full blur-3xl -translate-y-1/4 translate-x-1/4" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-72 sm:w-[30rem] h-72 sm:h-[30rem] bg-amber-50/40 rounded-full blur-3xl translate-y-1/3 -translate-x-1/4" aria-hidden="true"></div>
      <div id="hero-grid" class="absolute inset-0 bg-[linear-gradient(to_right,#f1f5f9_1px,transparent_1px),linear-gradient(to_bottom,#f1f5f9_1px,transparent_1px)] bg-[size:5rem_5rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_30%,transparent_70%)] parallax-gpu" aria-hidden="true"></div>

      <!-- Hero Left Tech Drawing Background -->
      <div id="hero-blueprint-left" class="absolute bottom-10 left-5 w-96 h-96 opacity-[0.18] pointer-events-none select-none hidden lg:block parallax-gpu" aria-hidden="true">
        <svg class="w-full h-full text-brand-600" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="0.75">
          <circle cx="60" cy="140" r="40" stroke-dasharray="2, 2" class="svg-orbit-slow" />
          <circle cx="60" cy="140" r="20" />
          <line x1="60" y1="100" x2="160" y2="40" />
          <line x1="60" y1="120" x2="160" y2="40" stroke-dasharray="1, 1" />
          <circle cx="160" cy="40" r="6" fill="currentColor" />
          <rect x="140" y="80" width="40" height="30" stroke-dasharray="2, 2" />
          <path d="M20 140 H180 M60 20 V180" stroke-width="0.5" />
          <text x="145" y="95" font-size="5" font-family="monospace">SYS_ALT_1</text>
          <text x="15" y="25" font-size="5" font-family="monospace">SCALE: 1:250</text>
        </svg>
      </div>

      <!-- Hero Right Tech Drawing Background (Telemetry & Matrix) -->
      <div id="hero-blueprint-right" class="absolute top-24 right-5 w-96 h-96 opacity-[0.18] pointer-events-none select-none hidden xl:block parallax-gpu" aria-hidden="true">
        <svg class="w-full h-full text-brand-600" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="0.75">
          <!-- Crosshair and coordinate lines -->
          <path d="M100 20 V180 M20 100 H180" stroke-dasharray="3, 3" stroke-width="0.5" />
          <!-- Rotating Radar Sweep Group -->
          <g class="svg-orbit-slow">
            <circle cx="100" cy="100" r="80" stroke-dasharray="1, 5" />
            <line x1="100" y1="100" x2="170" y2="30" />
          </g>
          <circle cx="100" cy="100" r="50" />
          <circle cx="100" cy="100" r="6" fill="currentColor" />
          <line x1="100" y1="100" x2="30" y2="170" stroke-dasharray="2, 2" />
          <!-- Floating system text -->
          <text x="110" y="35" font-size="5" font-family="monospace">SYS_HERO_INIT: OK</text>
          <text x="110" y="45" font-size="5" font-family="monospace">COORD: 0x4f8e2a</text>
          <text x="110" y="55" font-size="5" font-family="monospace">VECTOR: [0.85, 0.42, 0.31]</text>
          <text x="25" y="92" font-size="5" font-family="monospace">ROTATION: +45.2°</text>
          <!-- Corner angle markers -->
          <path d="M15 15 H25 M15 15 V25" stroke-width="1" />
          <path d="M185 15 H175 M185 15 V25" stroke-width="1" />
          <path d="M15 185 H25 M15 185 V175" stroke-width="1" />
          <path d="M185 185 H175 M185 185 V175" stroke-width="1" />
        </svg>
      </div>

      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
          <!-- Hero Text -->
          <div class="lg:col-span-7 space-y-6 sm:space-y-8">
            <!-- Glowing Badge -->
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-50/60 border border-brand-100 text-brand-700 text-xs font-semibold backdrop-blur-sm reveal">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-600"></span>
              </span>
              Infrastruktur Sains Terbuka Indonesia
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.6rem] font-black text-ink leading-[1.05] tracking-tight text-balance reveal">
              Infrastruktur riset <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 via-brand-500 to-brand-400">terbuka untuk semua.</span>
              <span class="block text-neutral-400 font-bold text-xl sm:text-2xl lg:text-[2.2rem] mt-3">
                Tanpa sekat vendor. Tanpa lisensi mahal.
              </span>
            </h1>

            <p class="text-base sm:text-lg text-neutral-500 leading-relaxed max-w-xl reveal text-pretty">
              Membangun kesadaran literasi ilmiah melalui <strong>OpenRiset Index</strong> (pencatatan sitasi ramah K-12 s.d. perguruan tinggi) dan <strong>OpenRiset Platform</strong> (jejaring sosial sains kredibel) untuk sains terbuka tanpa sekat vendor.
            </p>

            <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 reveal">
              <a href="#why" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-ink text-white font-semibold text-sm hover:bg-brand-700 transition-colors shadow-xl shadow-ink/10 group">
                Kenapa ini penting
                <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
              </a>
              <a href="#projects" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-neutral-200 bg-white text-neutral-600 font-semibold text-sm hover:border-neutral-300 hover:text-ink transition-colors group">
                Jelajahi Proyek
                <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>

            <!-- Specs Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 pt-6 max-w-xl reveal-slow">
              <div class="border-l-2 border-brand-200 pl-4"><span class="text-lg sm:text-xl font-bold text-ink font-display">MIT</span><span class="block text-[11px] text-neutral-400 mt-0.5">Lisensi Terbuka</span></div>
              <div class="border-l-2 border-brand-200 pl-4"><span class="text-lg sm:text-xl font-bold text-ink font-display">100%</span><span class="block text-[11px] text-neutral-400 mt-0.5">Kode Publik</span></div>
              <div class="border-l-2 border-brand-200 pl-4"><span class="text-lg sm:text-xl font-bold text-ink font-display">Rp0</span><span class="block text-[11px] text-neutral-400 mt-0.5">Tanpa Biaya</span></div>
              <div class="border-l-2 border-brand-200 pl-4"><span class="text-lg sm:text-xl font-bold text-ink font-display">Multidisiplin</span><span class="block text-[11px] text-neutral-400 mt-0.5">Semua Bidang</span></div>
            </div>
          </div>

          <!-- Hero Right: Interactive Protocol Dashboard -->
          <div class="lg:col-span-5 reveal-slow">
            <div class="relative rounded-2xl border border-neutral-200 bg-white/70 p-5 shadow-2xl backdrop-blur-md tech-corners">
              <!-- Top bar -->
              <div class="flex items-center justify-between border-b border-neutral-100 pb-3 mb-4">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
                </div>
                <span class="text-[10px] font-mono font-medium text-neutral-400 uppercase tracking-wider">openriset-protocol-v1</span>
              </div>
              
              <!-- Content flow -->
              <div class="space-y-4">
                <!-- Step 1: Input -->
                <div class="p-3 bg-neutral-50 rounded-xl border border-neutral-200/50">
                  <span class="text-[10px] font-mono font-bold text-brand-600 block mb-1">01 / INPUT KARYA ILMIAH</span>
                  <div class="flex items-center justify-between">
                    <div>
                      <span class="text-xs font-semibold text-ink block">Skripsi &amp; Laporan Riset</span>
                      <span class="text-[10px] text-neutral-400 block">PDF / Markdown &bull; Terkoneksi Lokal</span>
                    </div>
                    <svg class="w-5 h-5 text-neutral-400 animate-pulse-slow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"/></svg>
                  </div>
                </div>

                <!-- Link/Arrow path -->
                <div class="flex justify-center my-1">
                  <div class="h-6 w-px border-l border-dashed border-brand-300"></div>
                </div>

                <!-- Step 2: Protocol parser -->
                <div class="p-3 bg-brand-50/50 rounded-xl border border-brand-100 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-24 h-24 bg-brand-200/20 rounded-full blur-xl"></div>
                  <span class="text-[10px] font-mono font-bold text-brand-600 block mb-1">02 / PARSING &amp; METADATA SCHEMA</span>
                  <div class="space-y-1.5 font-mono text-[9px] text-neutral-500">
                    <div class="flex justify-between"><span class="text-brand-700">@context:</span><span>"https://schema.org"</span></div>
                    <div class="flex justify-between"><span class="text-brand-700">@type:</span><span>"ScholarlyArticle"</span></div>
                    <div class="flex justify-between"><span class="text-brand-700">identifier:</span><span class="text-emerald-600">"orid:citation:e82ba0"</span></div>
                  </div>
                </div>

                <!-- Link/Arrow path -->
                <div class="flex justify-center my-1">
                  <div class="h-6 w-px border-l border-dashed border-brand-300"></div>
                </div>

                <!-- Step 3: Social & Citation Integration -->
                <div class="p-3 bg-neutral-900 rounded-xl border border-neutral-800 text-white">
                  <span class="text-[10px] font-mono font-bold text-emerald-400 block mb-1">03 / INDEX & PLATFORM INTEGRATION</span>
                  <div class="flex items-center gap-3">
                    <!-- Graph nodes representation -->
                    <div class="flex -space-x-2 overflow-hidden py-1">
                      <div class="w-6 h-6 rounded-full bg-brand-500 border-2 border-neutral-900 flex items-center justify-center text-[8px] font-bold">IDX</div>
                      <div class="w-6 h-6 rounded-full bg-emerald-500 border-2 border-neutral-900 flex items-center justify-center text-[8px] font-bold">PF</div>
                      <div class="w-6 h-6 rounded-full bg-purple-500 border-2 border-neutral-900 flex items-center justify-center text-[8px] font-bold">KF</div>
                    </div>
                    <div class="flex-1">
                      <span class="text-[10px] text-neutral-300 block font-medium">Reputasi &amp; Sitasi Terintegrasi</span>
                      <span class="text-[9px] text-neutral-500 block font-mono">Cendol &amp; Bata Reputation &bull; Cloud Native</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ WHY (COMPARATIVE) ═══════════════════════════════════════════ -->
    <section id="why" class="relative py-16 sm:py-24 bg-soft border-y border-neutral-100 bg-dot-grid overflow-visible">
      <div class="absolute inset-0 bg-gradient-to-b from-white via-transparent to-white pointer-events-none" aria-hidden="true"></div>
      
      <!-- Technical margin markers -->
      <div class="absolute top-10 left-5 font-mono text-[9px] text-neutral-400 select-none hidden lg:block" aria-hidden="true">
        REF_PT: 0.14-A // LAT: -6.2088 // LONG: 106.8456
      </div>
      <div class="absolute bottom-10 right-5 font-mono text-[9px] text-neutral-400 select-none hidden lg:block" aria-hidden="true">
        SYS_STATUS: VERIFIED // SYNC: 100%
      </div>

      <!-- Why Section Large Blueprint Flowchart -->
      <div id="why-flowchart" class="absolute top-10 left-10 w-[50rem] h-[30rem] opacity-[0.16] pointer-events-none select-none hidden xl:block parallax-gpu" aria-hidden="true">
        <svg class="w-full h-full text-ink" viewBox="0 0 800 400" fill="none" stroke="currentColor" stroke-width="0.75">
          <rect x="50" y="150" width="120" height="60" rx="4" />
          <rect x="250" y="80" width="120" height="60" rx="4" stroke-dasharray="3, 3" />
          <rect x="250" y="220" width="120" height="60" rx="4" />
          <rect x="450" y="150" width="120" height="60" rx="4" />
          <rect x="650" y="150" width="100" height="60" rx="4" />
          <path id="why-path-1" d="M170 180 H210 V110 H250 M170 180 H210 V250 H250" />
          <path id="why-path-2" d="M370 110 H410 V180 H450 M370 250 H410 V180 H450" />
          <path id="why-path-3" d="M570 180 H650" />
          <text x="60" y="185" font-size="8" font-family="monospace" fill="currentColor" stroke="none">Data Source</text>
          <text x="260" y="115" font-size="8" font-family="monospace" fill="currentColor" stroke="none">Commercial DB</text>
          <text x="260" y="255" font-size="8" font-family="monospace" fill="currentColor" stroke="none">OpenRiset Index</text>
          <text x="460" y="185" font-size="8" font-family="monospace" fill="currentColor" stroke="none">Global Graph</text>
          <text x="660" y="185" font-size="8" font-family="monospace" fill="currentColor" stroke="none">Public Access</text>
          <circle cx="210" cy="110" r="3" fill="currentColor" />
          <circle cx="210" cy="250" r="3" fill="currentColor" />
          <circle cx="410" cy="180" r="3" fill="currentColor" />
        </svg>
      </div>

      <!-- Why Section Decentralized Topology Background (Right) -->
      <div id="why-swarm" class="absolute bottom-10 right-10 w-[24rem] h-[24rem] opacity-[0.16] pointer-events-none select-none hidden lg:block parallax-gpu" aria-hidden="true">
        <svg class="w-full h-full text-brand-600" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="0.75">
          <!-- Central ring -->
          <circle cx="100" cy="100" r="25" stroke-dasharray="3, 3" class="svg-orbit-reverse-slow" />
          <!-- Decentralized nodes -->
          <circle cx="100" cy="40" r="8" fill="currentColor" />
          <circle cx="45" cy="80" r="8" />
          <circle cx="155" cy="80" r="8" />
          <circle cx="65" cy="150" r="8" />
          <circle cx="135" cy="150" r="8" />
          <!-- Connections -->
          <line x1="100" y1="48" x2="45" y2="72" />
          <line x1="100" y1="48" x2="155" y2="72" />
          <line x1="45" y1="88" x2="65" y2="142" />
          <line x1="155" y1="88" x2="135" y2="142" />
          <line x1="65" y1="150" x2="135" y2="150" stroke-dasharray="2, 2" />
          <line x1="100" y1="40" x2="100" y2="100" stroke-dasharray="1, 1" />
          <!-- Extra telemetry texts -->
          <text x="100" y="25" font-size="5" font-family="monospace" text-anchor="middle" fill="currentColor" stroke="none">NODE_PEER_01</text>
          <text x="30" y="70" font-size="5" font-family="monospace" text-anchor="middle" fill="currentColor" stroke="none">NODE_PEER_02</text>
          <text x="170" y="70" font-size="5" font-family="monospace" text-anchor="middle" fill="currentColor" stroke="none">NODE_PEER_03</text>
          <text x="100" y="103" font-size="5" font-family="monospace" text-anchor="middle" fill="currentColor" stroke="none">IPFS_DHT_SWARM</text>
        </svg>
      </div>
      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <div class="font-mono text-[10px] text-neutral-400 mb-2">[SEC_01 / LITERACY_PARADIGM]</div>
          <span class="text-brand-600 text-xs font-bold uppercase tracking-widest">Paradigma Baru</span>
          <h2 class="mt-3 text-2xl sm:text-4xl font-extrabold text-ink leading-tight">
            Riset Indonesia butuh fondasi terbuka, bukan ekosistem terkunci
          </h2>
          <p class="mt-4 text-base text-neutral-500 leading-relaxed text-balance">
            Model publikasi akademis tradisional menuntut biaya berlangganan tinggi dan membatasi kepemilikan data. OpenRiset hadir untuk memberikan alternatif yang bebas dimiliki sepenuhnya oleh publik.
          </p>
        </div>

        <!-- Collapsible wrapper for mobile -->
        <div id="why-collapse" class="mobile-collapse-body">
          <!-- Comparative Grid -->
          <div class="grid md:grid-cols-2 gap-8 items-stretch reveal-slow mobile-carousel" id="why-carousel">
            <!-- Column 1: Traditional platform -->
            <div class="rounded-2xl border border-red-100 bg-white p-6 sm:p-8 flex flex-col justify-between shadow-sm relative overflow-hidden group tech-corners">
              <div class="absolute top-0 right-0 w-24 h-24 bg-red-50/40 rounded-full blur-xl group-hover:scale-125 transition-transform"></div>
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-700 text-xs font-semibold mb-6">
                  Platform Berlangganan / Vendor Lock-in
                </div>
                <h3 class="text-lg font-bold text-ink mb-4">Sistem Riset Tradisional (Tertutup)</h3>
                <ul class="space-y-4">
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
                    <div>
                      <span class="text-sm font-semibold text-ink block">Karya Ilmiah Rentan Hilang</span>
                      <span class="text-xs text-neutral-500 leading-normal block mt-0.5">Tugas akhir siswa sekolah dan skripsi kampus kecil seringkali hilang tanpa jejak digital atau indeksasi formal.</span>
                    </div>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
                    <div>
                      <span class="text-sm font-semibold text-ink block">Format Metadata Tidak Seragam</span>
                      <span class="text-xs text-neutral-500 leading-normal block mt-0.5">Setiap institusi menggunakan format berbeda (Excel, PDF mentah, dsb) sehingga mempersulit penelusuran data antar sistem.</span>
                    </div>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
                    <div>
                      <span class="text-sm font-semibold text-ink block">Ketergantungan Server Tunggal</span>
                      <span class="text-xs text-neutral-500 leading-normal block mt-0.5">Data terisolasi di server vendor komersial. Jika masa langganan habis, akses ke jejak ilmiah institusi terancam terputus.</span>
                    </div>
                  </li>
                </ul>
              </div>
              <div class="border-t border-neutral-100 pt-6 mt-8">
                <span class="text-xs text-neutral-400 font-mono">Biaya Operasional: Jutaan Rupiah &bull; Skala Terbatas</span>
              </div>
            </div>

            <!-- Column 2: OpenRiset Model -->
            <div class="rounded-2xl border border-brand-200 bg-white p-6 sm:p-8 flex flex-col justify-between shadow-xl relative overflow-hidden group tech-corners">
              <div class="absolute top-0 right-0 w-32 h-32 bg-brand-50/60 rounded-full blur-xl group-hover:scale-125 transition-transform"></div>
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-semibold mb-6">
                  Ekosistem Kolaboratif / Open Source
                </div>
                <h3 class="text-lg font-bold text-ink mb-4">Ekosistem Sains Terbuka (OpenRiset)</h3>
                <ul class="space-y-4">
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                    <div>
                      <span class="text-sm font-semibold text-ink block">Indeksasi Permanen dan Terbuka</span>
                      <span class="text-xs text-neutral-500 leading-normal block mt-0.5">Menjamin rekam jejak riset generasi muda (SD s.d. Perguruan Tinggi) dapat diindeks, dirujuk, dan disitasi secara permanen.</span>
                    </div>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                    <div>
                      <span class="text-sm font-semibold text-ink block">Standar Metadata Skema Internasional</span>
                      <span class="text-xs text-neutral-500 leading-normal block mt-0.5">Kompatibel penuh dengan standar internasional (SINTA, Crossref, DataCite) untuk pertukaran data yang mulus.</span>
                    </div>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                    <div>
                      <span class="text-sm font-semibold text-ink block">Kedaulatan Data Penuh</span>
                      <span class="text-xs text-neutral-500 leading-normal block mt-0.5">Kode sumber berlisensi MIT. Institusi dapat men-deploy di server mereka sendiri secara independen tanpa biaya royalti.</span>
                    </div>
                  </li>
                </ul>
              </div>
              <div class="border-t border-brand-100 pt-6 mt-8">
                <span class="text-xs text-brand-600 font-mono font-medium">Skala Serverless: Cloud-Native &amp; Bebas Royalti</span>
              </div>
            </div>
          </div>

          <!-- Carousel Navigation Dots visible only on mobile -->
          <div class="flex md:hidden justify-center gap-1.5 mt-4" id="why-carousel-dots">
            <span class="w-3 h-1.5 rounded-full bg-brand-600 transition-all duration-300" data-index="0"></span>
