---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const TITLE = "OpenRiset — Infrastruktur Sains Terbuka untuk Indonesia";
const DESC = "OpenRiset membangun standar, perangkat lunak, dan ekosistem publikasi ilmiah terbuka untuk semua disiplin ilmu — dari universitas, lembaga riset, sekolah, hingga peneliti independen.";
---

<Layout title={TITLE} description={DESC}>
  <div id="top"></div>
  <Nav />

  <main>
    <!-- ═══════════════════ HERO ═══════════════════ -->
    <section class="relative overflow-hidden bg-gradient-to-b from-neutral-50 via-white to-white pt-16 sm:pt-24 lg:pt-32 pb-16 sm:pb-20 lg:pb-24">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(59,130,246,0.08),transparent)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#f1f5f9_1px,transparent_1px),linear-gradient(to_bottom,#f1f5f9_1px,transparent_1px)] bg-[size:5rem_5rem] [mask-image:radial-gradient(ellipse_70%_40%_at_50%_0%,#000_20%,transparent_60%)]"></div>

      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/70 border border-neutral-200/60 backdrop-blur text-brand-700 text-xs sm:text-sm font-medium mb-6 sm:mb-8 reveal">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
            Open Source &bull; Non-Profit &bull; Independen
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-neutral-900 leading-[1.06] tracking-tight text-balance reveal" style="transition-delay: 0.1s">
            Infrastruktur riset terbuka untuk
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-brand-400">semua disiplin ilmu</span>
          </h1>

          <p class="mt-5 sm:mt-6 text-base sm:text-lg text-neutral-600 leading-relaxed max-w-xl reveal text-pretty" style="transition-delay: 0.2s">
            OpenRiset membangun standar, perangkat lunak, dan ekosistem publikasi ilmiah yang dapat digunakan oleh universitas, lembaga riset, sekolah, dan peneliti independen — tanpa terikat institusi, disiplin, atau vendor manapun.
          </p>

          <div class="mt-7 sm:mt-9 flex flex-col sm:flex-row gap-3 sm:gap-4 reveal" style="transition-delay: 0.3s">
            <a href="#why" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-neutral-900 text-white font-semibold text-sm sm:text-base hover:bg-neutral-800 transition-colors shadow-lg shadow-neutral-900/10">
              Mengapa OpenRiset
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
            </a>
            <a href="https://github.com/openriset" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-neutral-300 bg-white text-neutral-700 font-semibold text-sm sm:text-base hover:bg-neutral-50 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
          </div>
        </div>

        <div class="mt-12 sm:mt-16 lg:mt-20 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-8 max-w-2xl reveal" style="transition-delay: 0.4s">
          <div class="text-center lg:text-left">
            <div class="text-2xl sm:text-3xl font-bold text-brand-600 tracking-tight">MIT</div>
            <div class="text-xs text-neutral-500 mt-1 font-medium">Lisensi Terbuka</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-2xl sm:text-3xl font-bold text-brand-600 tracking-tight">100%</div>
            <div class="text-xs text-neutral-500 mt-1 font-medium">Open Source</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-2xl sm:text-3xl font-bold text-brand-600 tracking-tight">Nol</div>
            <div class="text-xs text-neutral-500 mt-1 font-medium">Biaya Akses</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-2xl sm:text-3xl font-bold text-brand-600 tracking-tight">Semua</div>
            <div class="text-xs text-neutral-500 mt-1 font-medium">Disiplin Ilmu</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ WHY — alternating blocks ═══════════════════ -->
    <section id="why" class="py-16 sm:py-20 lg:py-28 section-collapsible">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <button type="button" class="section-toggle-btn w-full text-left block md:cursor-default mb-10 sm:mb-14 lg:mb-16" aria-expanded="true">
          <p class="text-brand-600 text-xs sm:text-sm font-semibold uppercase tracking-widest mb-3 reveal">Masalah</p>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-neutral-900 leading-[1.15] tracking-tight max-w-2xl reveal" style="transition-delay: 0.05s">
            Riset di Indonesia butuh fondasi, bukan platform tertutup
          </h2>
        </button>

        <div class="section-body expanded">
          <!-- Row 1: text L + visual R -->
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center mb-16 lg:mb-24 reveal" style="transition-delay: 0.1s">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <span class="w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center text-red-500 flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </span>
                <h3 class="text-lg sm:text-xl font-bold text-neutral-900">Karya ilmiah hilang tanpa jejak</h3>
              </div>
              <p class="text-neutral-600 leading-relaxed text-sm sm:text-base">
                Setelah lomba atau publikasi, karya siswa dan peneliti lenyap — tidak terindeks, tidak bisa diverifikasi, tidak bisa disitasi. Indonesia kehilangan jejak intelektual generasinya sendiri.
              </p>
            </div>
            <div class="bg-neutral-50 rounded-2xl p-6 sm:p-8 border border-neutral-200/60">
              <div class="flex items-center gap-3 text-neutral-400 text-sm font-mono">
                <span class="w-2 h-2 rounded-full bg-red-400"></span>
                <span>404 — Karya tidak ditemukan</span>
              </div>
              <div class="mt-3 h-2 bg-neutral-200 rounded-full w-3/4"></div>
              <div class="mt-2 h-2 bg-neutral-100 rounded-full w-1/2"></div>
              <div class="mt-4 space-y-2">
                <div class="h-12 bg-white rounded-lg border border-neutral-200/60 flex items-center px-4 gap-3">
                  <span class="w-3 h-3 rounded-full bg-neutral-300"></span>
                  <span class="text-xs text-neutral-400">Laporan Penelitian — Hilang</span>
                </div>
                <div class="h-12 bg-white rounded-lg border border-neutral-200/60 flex items-center px-4 gap-3">
                  <span class="w-3 h-3 rounded-full bg-neutral-300"></span>
                  <span class="text-xs text-neutral-400">Paper Kompetisi — Hilang</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Row 2: visual L + text R -->
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center mb-16 lg:mb-24 reveal" style="transition-delay: 0.15s">
            <div class="order-last lg:order-first bg-neutral-50 rounded-2xl p-6 sm:p-8 border border-neutral-200/60">
              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span class="text-sm font-medium text-neutral-700">Metadata terstandarisasi</span>
                </div>
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span class="text-sm font-medium text-neutral-700">Kompatibel Crossref & DataCite</span>
                </div>
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span class="text-sm font-medium text-neutral-700">Ditemukan dalam hitungan detik</span>
                </div>
              </div>
            </div>
            <div>
              <div class="flex items-center gap-3 mb-4">
                <span class="w-8 h-8 rounded-lg bg-brand-50 flex items-center justify-center text-brand-500 flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
                <h3 class="text-lg sm:text-xl font-bold text-neutral-900">Tidak ada standar metadata terbuka</h3>
              </div>
              <p class="text-neutral-600 leading-relaxed text-sm sm:text-base">
                Setiap institusi punya format sendiri. Data tidak interoperabel. Peneliti tidak bisa membangun di atas karya sebelumnya karena metadatanya tersebar di sistem yang tidak kompatibel.
              </p>
            </div>
          </div>

          <!-- Row 3: text L + visual R -->
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center reveal" style="transition-delay: 0.2s">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <span class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center text-amber-500 flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                </span>
                <h3 class="text-lg sm:text-xl font-bold text-neutral-900">Platform yang ada tertutup dan mahal</h3>
              </div>
              <p class="text-neutral-600 leading-relaxed text-sm sm:text-base">
                Platform publikasi komersial mengunci riset di balik paywall. Biaya langganan tinggi. Data tidak bisa diakses publik. Institusi kecil dan peneliti independen tersingkir.
              </p>
            </div>
            <div class="bg-neutral-50 rounded-2xl p-6 sm:p-8 border border-neutral-200/60">
              <div class="flex gap-2 mb-3">
                <span class="px-3 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full">$5,000/thn</span>
                <span class="px-3 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full">Vendor lock-in</span>
                <span class="px-3 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full">Data tertutup</span>
              </div>
              <div class="text-4xl font-bold text-red-400 mb-2">✕</div>
              <p class="text-sm text-neutral-500">Ini bukan infrastruktur riset. Ini bisnis.</p>
              <div class="mt-4 pt-4 border-t border-neutral-200">
                <div class="flex gap-2">
                  <span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">Gratis</span>
                  <span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">Open source</span>
                  <span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">Data milik Anda</span>
                </div>
                <div class="text-4xl font-bold text-green-500 mb-2 mt-1">✓</div>
                <p class="text-sm text-neutral-500">Ini OpenRiset.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ VISION — centered manifesto ═══════════════════ -->
    <section id="vision" class="py-16 sm:py-20 lg:py-28 bg-neutral-50 section-collapsible">
      <div class="max-w-4xl mx-auto px-5 sm:px-8 lg:px-10 text-center">
        <button type="button" class="section-toggle-btn w-full text-center md:cursor-default block mb-8 sm:mb-10 lg:mb-14" aria-expanded="true">
          <p class="text-brand-600 text-xs sm:text-sm font-semibold uppercase tracking-widest mb-3">Visi & Misi</p>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-neutral-900 leading-[1.15] tracking-tight reveal">
            Fondasi riset Indonesia yang terbuka, <br class="hidden sm:block" />terverifikasi, dan aksesibel untuk semua
          </h2>
        </button>

        <div class="section-body expanded">
          <!-- Big statement -->
          <div class="relative max-w-2xl mx-auto mb-12 sm:mb-16 reveal" style="transition-delay: 0.1s">
            <div class="absolute -top-6 -left-6 sm:-top-10 sm:-left-10 w-12 sm:w-16 h-12 sm:h-16 rounded-full bg-brand-100 opacity-60"></div>
            <p class="text-base sm:text-lg lg:text-xl text-neutral-600 leading-relaxed relative">
              Kami percaya bahwa <span class="font-semibold text-neutral-900">setiap karya ilmiah</span> — dari laporan eksperimen siswa SD hingga disertasi doktoral — <span class="font-semibold text-neutral-900">layak diindeks, diverifikasi, dan disitasi</span>. Bukan hanya karya dari institusi besar atau peneliti mapan.
            </p>
          </div>

          <!-- 2-column manifesto -->
          <div class="grid sm:grid-cols-2 gap-6 sm:gap-8 lg:gap-10 text-left reveal" style="transition-delay: 0.15s">
            <div class="bg-white rounded-2xl p-6 sm:p-8 border border-neutral-200/60">
              <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-neutral-900 mb-2">Misi kami</h3>
              <p class="text-sm text-neutral-500 leading-relaxed">
                Mengembangkan perangkat lunak open-source, standar metadata, dan protokol verifikasi yang memungkinkan <strong class="text-neutral-700">institusi manapun</strong> membangun platform riset mereka sendiri.
              </p>
            </div>
            <div class="bg-white rounded-2xl p-6 sm:p-8 border border-neutral-200/60">
              <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-neutral-900 mb-2">Nilai kami</h3>
              <p class="text-sm text-neutral-500 leading-relaxed">
                <strong class="text-neutral-700">Independen.</strong> Tidak terafiliasi institusi atau pendanaan manapun.
                <strong class="text-neutral-700">Terbuka.</strong> Semua kode MIT, semua keputusan publik.
                <strong class="text-neutral-700">Inklusif.</strong> Dari siswa SD hingga profesor.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ PROJECTS ═══════════════════ -->
    <section id="projects" class="py-16 sm:py-20 lg:py-28 section-collapsible">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <button type="button" class="section-toggle-btn w-full text-left md:cursor-default block mb-10 sm:mb-14 lg:mb-16">
          <p class="text-brand-600 text-xs sm:text-sm font-semibold uppercase tracking-widest mb-3 reveal">Proyek</p>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-neutral-900 leading-[1.15] tracking-tight max-w-2xl reveal" style="transition-delay: 0.05s">
            Tiga pilar fondasi ekosistem
          </h2>
        </button>

        <div class="section-body">
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 reveal" style="transition-delay: 0.1s">
            <a href="https://github.com/openriset/community" target="_blank" rel="noopener" class="group bg-white rounded-2xl border border-neutral-200/60 p-6 sm:p-8 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-100/30 transition-all duration-300">
              <div class="w-10 h-10 rounded-xl bg-neutral-900 flex items-center justify-center text-white text-sm font-bold mb-5">01</div>
              <h3 class="text-lg font-bold text-neutral-900 mb-2 group-hover:text-brand-700 transition-colors">Community</h3>
              <p class="text-sm text-neutral-500 leading-relaxed mb-4">Monorepo utama — seluruh kode sumber aplikasi, shared packages, konfigurasi Docker, pipeline CI/CD. Satu tempat untuk semua.</p>
              <span class="inline-flex items-center gap-1 text-xs font-medium text-brand-600">
                TypeScript
                <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
            <a href="https://github.com/openriset/spec" target="_blank" rel="noopener" class="group bg-white rounded-2xl border border-neutral-200/60 p-6 sm:p-8 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-100/30 transition-all duration-300">
              <div class="w-10 h-10 rounded-xl bg-neutral-900 flex items-center justify-center text-white text-sm font-bold mb-5">02</div>
              <h3 class="text-lg font-bold text-neutral-900 mb-2 group-hover:text-brand-700 transition-colors">Spec</h3>
              <p class="text-sm text-neutral-500 leading-relaxed mb-4">Spesifikasi teknis, keputusan arsitektur, standar metadata, dan protokol verifikasi. Dokumen yang menjadi acuan interoperabilitas.</p>
              <span class="inline-flex items-center gap-1 text-xs font-medium text-brand-600">
                Markdown
                <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
            <a href="https://github.com/openriset/citation" target="_blank" rel="noopener" class="group bg-white rounded-2xl border border-neutral-200/60 p-6 sm:p-8 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-100/30 transition-all duration-300 sm:col-span-2 lg:col-span-1">
              <div class="w-10 h-10 rounded-xl bg-neutral-900 flex items-center justify-center text-white text-sm font-bold mb-5">03</div>
              <h3 class="text-lg font-bold text-neutral-900 mb-2 group-hover:text-brand-700 transition-colors">Citation</h3>
              <p class="text-sm text-neutral-500 leading-relaxed mb-4">Standar dan library sitasi terbuka. Format interoperabel untuk pertukaran data referensi antar platform riset.</p>
              <span class="inline-flex items-center gap-1 text-xs font-medium text-brand-600">
                TypeScript
                <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ STANDARDS — icon grid ═══════════════════ -->
    <section id="standards" class="py-16 sm:py-20 lg:py-28 bg-neutral-50 section-collapsible">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <button type="button" class="section-toggle-btn w-full text-center md:cursor-default block mb-10 sm:mb-14 lg:mb-16">
          <p class="text-brand-600 text-xs sm:text-sm font-semibold uppercase tracking-widest mb-3 reveal">Standar & Pendekatan</p>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-neutral-900 leading-[1.15] tracking-tight reveal" style="transition-delay: 0.05s">
            Enam prinsip yang memandu <br class="hidden sm:block" />setiap keputusan kami
          </h2>
        </button>

        <div class="section-body">
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 reveal" style="transition-delay: 0.1s">
            <div class="text-center p-4 sm:p-6 bg-white rounded-2xl border border-neutral-200/60 hover:border-brand-200 hover:shadow-md transition-all duration-300">
              <div class="w-10 h-10 mx-auto rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <h4 class="text-sm font-bold text-neutral-900">Metadata Standar</h4>
            </div>
            <div class="text-center p-4 sm:p-6 bg-white rounded-2xl border border-neutral-200/60 hover:border-brand-200 hover:shadow-md transition-all duration-300">
              <div class="w-10 h-10 mx-auto rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-3">
