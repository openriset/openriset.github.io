  <script>
    const obs = new IntersectionObserver(
      (entries) => { entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }); },
      { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
    );
    document.querySelectorAll('.reveal, .reveal-slow').forEach(el => obs.observe(el));

    document.querySelectorAll('.section-toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const body = btn.parentElement?.querySelector('.section-body');
        if (!body) return;
        const open = body.classList.toggle('expanded');
        btn.setAttribute('aria-expanded', String(open));
      });
    });

    // ── Auto-slider carousel ──
    document.querySelectorAll('.auto-slider').forEach((slider) => {
      const el = slider as HTMLElement;
      const slides = el.querySelectorAll<HTMLElement>('.slide');
      if (slides.length <= 1) return;

      const interval = parseInt(el.dataset.interval ?? '') || 4000;
      const dotsContainer = el.nextElementSibling;
      let current = 0;
      let timer: ReturnType<typeof setInterval>;

      if (dotsContainer?.classList.contains('slider-dots')) {
        dotsContainer.innerHTML = '';
        slides.forEach((_, i) => {
          const dot = document.createElement('span');
          dot.className = 'slider-dot' + (i === 0 ? ' active' : '');
          dot.addEventListener('click', () => goTo(i));
          dotsContainer.appendChild(dot);
        });
      }

      function goTo(index: number) {
        slides[current]?.classList.remove('active');
        if (dotsContainer) (dotsContainer.children[current] as HTMLElement)?.classList.remove('active');
        current = index;
        slides[current]?.classList.add('active');
        if (dotsContainer) (dotsContainer.children[current] as HTMLElement)?.classList.add('active');
        clearInterval(timer);
        timer = setInterval(next, interval);
      }

      function next() { goTo((current + 1) % slides.length); }
      timer = setInterval(next, interval);
    });
  </script>

