  <!-- Interactive Client-side Script -->
  <script>
    // 1. Intersection Observer for Scroll Reveal animations
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) e.target.classList.add('visible');
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px -20px 0px' }
    );
    document.querySelectorAll('.reveal, .reveal-slow').forEach(el => obs.observe(el));

    // 2. Spotlight Border Glow Effect
    document.querySelectorAll('.spotlight-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const mouseEvent = e as MouseEvent;
        const target = card as HTMLElement;
        const rect = target.getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;
        target.style.setProperty('--mouse-x', `${x}px`);
        target.style.setProperty('--mouse-y', `${y}px`);
      });
    });

    // 3. Interactive Code Terminal tabs with typewriter effect
    const tabs = document.querySelectorAll('.term-tab');
    const contents = document.querySelectorAll('.term-content');

    function typeWriter(element: HTMLElement, text: string, callback?: () => void) {
      element.textContent = "";
      let i = 0;
      function type() {
        if (i < text.length) {
          element.textContent += text.charAt(i);
          i++;
          setTimeout(type, Math.random() * 15 + 10);
        } else {
          if (callback) callback();
        }
      }
      type();
    }

    function runTerminalTypewriter(tabId: string) {
      const activeContent = document.getElementById(`term-${tabId}`);
      if (!activeContent) return;

      const cmdSpan = activeContent.querySelector('.term-cmd') as HTMLElement;
      const outputDiv = activeContent.querySelector('.term-output') as HTMLElement;

      if (cmdSpan) {
        const fullCmd = cmdSpan.getAttribute('data-cmd') || '';
        if (outputDiv) {
          outputDiv.classList.add('opacity-0');
          outputDiv.style.display = 'none';
        }
        
        typeWriter(cmdSpan, fullCmd, () => {
          if (outputDiv) {
            outputDiv.style.display = 'block';
            // Trigger browser reflow to run CSS opacity transition
            outputDiv.offsetHeight;
            outputDiv.classList.remove('opacity-0');
          }
        });
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target') || '';
        
        tabs.forEach(t => {
          t.classList.remove('bg-white', 'text-ink');
          t.classList.add('text-neutral-500');
        });
        tab.classList.add('bg-white', 'text-ink');
        tab.classList.remove('text-neutral-500');
        
        contents.forEach(c => {
          c.classList.add('hidden');
          if (c.id === `term-${target}`) {
            c.classList.remove('hidden');
          }
        });

        // Trigger glitch effect on terminal
        const termContainer = document.querySelector('.mock-terminal');
        if (termContainer) {
          termContainer.classList.add('glitch-active');
          setTimeout(() => {
            termContainer.classList.remove('glitch-active');
          }, 250);
        }

        // Trigger typewriter simulation for target tab
        runTerminalTypewriter(target);
      });
    });

    // Run typewriter once on initial community tab
    runTerminalTypewriter('community');

    // 4. Live Metadata Schema Sandbox Logic
    const titleInput = document.getElementById('sandbox-title') as HTMLInputElement;
    const authorInput = document.getElementById('sandbox-author') as HTMLInputElement;
    const outputCode = document.getElementById('sandbox-output') as HTMLElement;

    function updateSchema() {
      if (!titleInput || !authorInput || !outputCode) return;
      const title = titleInput.value || "Studi Ekstraksi Daun Kemangi";
      const author = authorInput.value || "Farhan Wijaya";
      
      // Generate a reproducible mock hash ID based on title+author
      let hash = 0;
      const str = title + author;
      for (let i = 0; i < str.length; i++) {
        hash = (Math.imul(31, hash) + str.charCodeAt(i)) | 0;
      }
      const mockHash = Math.abs(hash).toString(16).padEnd(8, '0').substring(0, 8);
      const orid = `orid:pub:${mockHash}`;

      const schema = {
        "@context": "https://schema.org",
        "@type": "ScholarlyArticle",
        "name": title,
        "author": {
          "@type": "Person",
          "name": author
        },
        "identifier": orid,
        "license": "https://spdx.org/licenses/MIT",
        "publisher": "OpenRiset Index"
      };

      outputCode.textContent = JSON.stringify(schema, null, 2);
    }

    if (titleInput && authorInput && outputCode) {
      titleInput.addEventListener('input', updateSchema);
      authorInput.addEventListener('input', updateSchema);
      // Initialize output
      updateSchema();
    }

    // 5. Interactive SVG Citation Graph Node Highlight
    const graphNodes = document.querySelectorAll('.graph-node');
    const graphLines = document.querySelectorAll('.graph-line');
    const graphInfo = document.getElementById('graph-info');

    let hoveredNode: Element | null = null;
    let selectedNode: Element | null = null;

    function updateGraphState() {
      const activeNode = selectedNode || hoveredNode;
      if (activeNode) {
        const nodeId = activeNode.getAttribute('data-id');
        const label = activeNode.getAttribute('data-label') || '';
        const desc = activeNode.getAttribute('data-desc') || '';
        
        if (graphInfo) {
          graphInfo.innerHTML = `<strong class="text-brand-400">${label}</strong><br /><span class="text-[10px] text-neutral-400">${desc}</span>`;
        }

        // Highlight connected lines with fast dash flow, dim others heavily
        graphLines.forEach(line => {
          const htmlLine = line as SVGElement;
          const connects = htmlLine.getAttribute('data-connects')?.split(',') || [];
          if (connects.includes(nodeId || '')) {
            htmlLine.classList.add('graph-flow-active');
            htmlLine.style.opacity = '1';
          } else {
            htmlLine.classList.remove('graph-flow-active');
            htmlLine.style.opacity = '0.12';
          }
        });
      } else {
        // Reset to default styling (subtle, slow moving dashes)
        graphLines.forEach(line => {
          const htmlLine = line as SVGElement;
          htmlLine.classList.remove('graph-flow-active');
          htmlLine.style.opacity = ''; // Let CSS take over
        });
        if (graphInfo) {
          graphInfo.innerHTML = 'Arahkan kursor ke node graf di atas untuk memeriksa jaringan rujukan ilmiah.';
        }
      }
    }

    graphNodes.forEach(node => {
      // Hover event listeners for mouse-enabled devices
      node.addEventListener('mouseenter', () => {
        if (!selectedNode) {
          hoveredNode = node;
          updateGraphState();
        }
      });

      node.addEventListener('mouseleave', () => {
        if (hoveredNode === node) {
          hoveredNode = null;
          updateGraphState();
        }
      });

      // Unified Click/Tap listener for touch screen devices
      node.addEventListener('click', (e) => {
        e.stopPropagation(); // Avoid triggering deselect on SVG canvas click
        if (selectedNode === node) {
          selectedNode = null; // Toggle selection off
        } else {
          selectedNode = node; // Set active selection
        }
        hoveredNode = null;
        updateGraphState();
      });
    });

    // Tap outside nodes to reset
    const graphSvg = document.querySelector('.graph-node')?.parentElement;
    if (graphSvg) {
