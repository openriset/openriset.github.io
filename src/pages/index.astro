        selectedNode = null;
        hoveredNode = null;
        updateGraphState();
      });
    }


    // 6. Live Telemetry Simulators
    const memEl = document.getElementById('telemetry-mem');
    const binLeftEl = document.getElementById('telemetry-binary-left');
    const binRightEl = document.getElementById('telemetry-binary-right');
    const ctaHashEl = document.getElementById('cta-hash-val');
    const ctaKeyEl = document.getElementById('cta-key-hash');
    const ctaTimeEl = document.getElementById('cta-timestamp');

    function generateBinaryByte() {
      let b = "";
      for (let i = 0; i < 8; i++) {
        b += Math.random() > 0.5 ? "1" : "0";
      }
      return b;
    }

    setInterval(() => {
