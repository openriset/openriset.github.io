      if (memEl) {
        const value = (11.8 + Math.random() * 1.7).toFixed(1);
        memEl.textContent = `MEM_LOAD: ${value}%`;
      }
      
      // Binary flow simulation
      if (binLeftEl) {
        binLeftEl.textContent = `${generateBinaryByte()} ${generateBinaryByte()}`;
      }
      if (binRightEl) {
        binRightEl.textContent = `${generateBinaryByte()} ${generateBinaryByte()}`;
      }

      // CTA logs simulation
      if (ctaHashEl) {
        const hex = Math.floor(Math.random() * 0xffffffff).toString(16).padEnd(8, '0');
        ctaHashEl.textContent = `HASH_VAL: ${hex}...`;
