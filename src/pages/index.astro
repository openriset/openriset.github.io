    // 7. Custom Magnetic Cursor Logic (Desktop only)
    let mouseX = 0, mouseY = 0;
    let dotX = 0, dotY = 0;
    let circleX = 0, circleY = 0;
    let magneticTarget: HTMLElement | null = null;

    const cursorDot = document.getElementById('cursor-dot');
    const cursorCircle = document.getElementById('cursor-circle');

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    const interactiveSelectors = 'a, button, select, input, textarea, [role="button"], .term-tab, .spotlight-card, .graph-node';
    const magneticSelectors = 'a, button, .term-tab';

    function initCursorEvents() {
      document.querySelectorAll(interactiveSelectors).forEach(el => {
        el.addEventListener('mouseenter', () => {
          cursorCircle?.classList.add('cursor-hover');
        });
        el.addEventListener('mouseleave', () => {
          cursorCircle?.classList.remove('cursor-hover');
        });
      });

      document.querySelectorAll(magneticSelectors).forEach(el => {
        const htmlEl = el as HTMLElement;
        htmlEl.addEventListener('mouseenter', () => {
          magneticTarget = htmlEl;
          cursorCircle?.classList.add('cursor-magnetic');
          cursorDot?.classList.add('cursor-magnetic-dot');
        });
        htmlEl.addEventListener('mouseleave', () => {
          magneticTarget = null;
          cursorCircle?.classList.remove('cursor-magnetic');
          cursorDot?.classList.remove('cursor-magnetic-dot');
        });
      });
    }

    const lerp = (start: number, end: number, amt: number) => (1 - amt) * start + amt * end;

    function updateCursor() {
      if (magneticTarget && cursorCircle) {
        const rect = magneticTarget.getBoundingClientRect();
        const targetX = rect.left + rect.width / 2;
        const targetY = rect.top + rect.height / 2;

        circleX = lerp(circleX, targetX, 0.25);
        circleY = lerp(circleY, targetY, 0.25);

        cursorCircle.style.transform = `translate3d(-50%, -50%, 0) translate3d(${circleX}px, ${circleY}px, 0)`;
        
        const padding = 12;
        cursorCircle.style.width = `${rect.width + padding}px`;
        cursorCircle.style.height = `${rect.height + padding}px`;
        cursorCircle.style.borderRadius = '6px';

        const dotTargetX = targetX + (mouseX - targetX) * 0.35;
        const dotTargetY = targetY + (mouseY - targetY) * 0.35;

        dotX = lerp(dotX, dotTargetX, 0.3);
        dotY = lerp(dotY, dotTargetY, 0.3);
        if (cursorDot) {
          cursorDot.style.transform = `translate3d(-50%, -50%, 0) translate3d(${dotX}px, ${dotY}px, 0)`;
        }
      } else {
        dotX = mouseX;
        dotY = mouseY;

        circleX = lerp(circleX, mouseX, 0.15);
        circleY = lerp(circleY, mouseY, 0.15);

        if (cursorDot) {
          cursorDot.style.transform = `translate3d(-50%, -50%, 0) translate3d(${dotX}px, ${dotY}px, 0)`;
        }
        if (cursorCircle) {
          cursorCircle.style.transform = `translate3d(-50%, -50%, 0) translate3d(${circleX}px, ${circleY}px, 0)`;
          cursorCircle.style.width = '32px';
          cursorCircle.style.height = '32px';
          cursorCircle.style.borderRadius = '50%';
        }
      }

      requestAnimationFrame(updateCursor);
    }

    if (window.matchMedia('(min-width: 1024px)').matches) {
      initCursorEvents();
      requestAnimationFrame(updateCursor);
    }

    // 8. Stat Bar Fourier Oscilloscope Sandbox & Audio Synthesizer Logic
    const sliderFreq = document.getElementById('slider-freq') as HTMLInputElement;
    const sliderAmp = document.getElementById('slider-amp') as HTMLInputElement;
    const sliderNoise = document.getElementById('slider-noise') as HTMLInputElement;

    const valFreq = document.getElementById('val-freq');
    const valAmp = document.getElementById('val-amp');
    const valNoise = document.getElementById('val-noise');

    const wavePrimary = document.getElementById('wave-primary');
    const waveSecondary = document.getElementById('wave-secondary');
    const btnToggleSignal = document.getElementById('btn-toggle-signal');
    const statSection = document.getElementById('stat-bar-section');

    let oscilloscopeVelocityMultiplier = 1.0;

    function updateOscilloscope() {
      if (!sliderFreq || !sliderAmp || !sliderNoise || !wavePrimary || !waveSecondary) return;
      const width = 1200;
      const height = 100;
      const midY = height / 2;

      const freq = parseFloat(sliderFreq.value);
      const amp = parseFloat(sliderAmp.value) * oscilloscopeVelocityMultiplier;
      const noise = parseFloat(sliderNoise.value);

      if (valFreq) valFreq.textContent = `${freq.toFixed(1)}Hz`;
      if (valAmp) valAmp.textContent = `${Math.round(amp)}px`;
      if (valNoise) valNoise.textContent = `${Math.round((noise / 30) * 100)}%`;

      // Draw primary wave (sine + harmonics)
      let d1 = `M 0 ${midY}`;
      for (let x = 0; x <= width; x += 4) {
        let angle = (x / width) * Math.PI * 2 * freq;
        let sineVal = Math.sin(angle) + 0.25 * Math.sin(angle * 3);
        let noiseVal = (Math.random() - 0.5) * noise;
        let y = midY - (sineVal * amp * 0.8) + noiseVal;
        d1 += ` L ${x} ${y}`;
      }
      wavePrimary.setAttribute('d', d1);

      // Draw secondary wave (cosine + harmonics, offset phase)
      let d2 = `M 0 ${midY}`;
      for (let x = 0; x <= width; x += 4) {
        let angle = (x / width) * Math.PI * 2 * freq + Math.PI / 4;
        let cosineVal = Math.cos(angle) + 0.15 * Math.cos(angle * 2);
        let noiseVal = (Math.random() - 0.5) * noise;
        let y = midY - (cosineVal * amp * 0.6) + noiseVal;
        d2 += ` L ${x} ${y}`;
      }
      waveSecondary.setAttribute('d', d2);
    }

    // Attach slider listeners
    if (sliderFreq && sliderAmp && sliderNoise) {
      sliderFreq.addEventListener('input', () => {
        updateOscilloscope();
        if (oscillator && audioCtx) {
          const freq = parseFloat(sliderFreq.value);
          oscillator.frequency.setValueAtTime(220 + freq * 44, audioCtx.currentTime);
        }
      });
      sliderAmp.addEventListener('input', () => {
        updateOscilloscope();
        if (primaryGain && audioCtx) {
          const amp = parseFloat(sliderAmp.value);
          primaryGain.gain.setValueAtTime((amp / 80) * 0.05, audioCtx.currentTime);
        }
      });
      sliderNoise.addEventListener('input', () => {
        updateOscilloscope();
        if (noiseGain && audioCtx) {
          const noise = parseFloat(sliderNoise.value);
          noiseGain.gain.setValueAtTime((noise / 30) * 0.015, audioCtx.currentTime);
        }
      });
    }

    // Web Audio Synthesis Logic
    let audioCtx: AudioContext | null = null;
    let oscillator: OscillatorNode | null = null;
    let noiseSource: AudioBufferSourceNode | null = null;
    let primaryGain: GainNode | null = null;
    let noiseGain: GainNode | null = null;
    let isAudioPlaying = false;

    function initAudio() {
      try {
        const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
        audioCtx = new AudioContextClass();

        // 1. Primary oscillator for wave hum
        oscillator = audioCtx.createOscillator();
        oscillator.type = 'sine';
        const freq = parseFloat(sliderFreq.value || '2');
        oscillator.frequency.value = 220 + freq * 44;

        primaryGain = audioCtx.createGain();
        const amp = parseFloat(sliderAmp.value || '40');
        primaryGain.gain.value = (amp / 80) * 0.05; // Keep it low and gentle

        oscillator.connect(primaryGain);
        primaryGain.connect(audioCtx.destination);
        oscillator.start();

        // 2. White noise buffer source
        const bufferSize = audioCtx.sampleRate * 2;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = Math.random() * 2 - 1;
        }

        noiseSource = audioCtx.createBufferSource();
        noiseSource.buffer = buffer;
        noiseSource.loop = true;

        noiseGain = audioCtx.createGain();
        const noiseVal = parseFloat(sliderNoise.value || '0');
        noiseGain.gain.value = (noiseVal / 30) * 0.015;

        noiseSource.connect(noiseGain);
        noiseGain.connect(audioCtx.destination);
        noiseSource.start();

        isAudioPlaying = true;
        if (btnToggleSignal) {
          btnToggleSignal.textContent = "Test Audio: On";
          btnToggleSignal.classList.add('bg-brand-600', 'text-white', 'border-brand-500');
          btnToggleSignal.classList.remove('bg-neutral-800', 'text-neutral-400', 'border-neutral-700');
        }
      } catch (err) {
        console.error('Failed to initialize audio', err);
      }
    }

    function stopAudio() {
      if (oscillator) {
        try { oscillator.stop(); } catch(e){}
        oscillator.disconnect();
        oscillator = null;
      }
      if (noiseSource) {
        try { noiseSource.stop(); } catch(e){}
        noiseSource.disconnect();
        noiseSource = null;
      }
      if (audioCtx) {
        try { audioCtx.close(); } catch(e){}
        audioCtx = null;
      }
      isAudioPlaying = false;
      if (btnToggleSignal) {
        btnToggleSignal.textContent = "Test Audio: Off";
        btnToggleSignal.classList.remove('bg-brand-600', 'text-white', 'border-brand-500');
        btnToggleSignal.classList.add('bg-neutral-800', 'text-neutral-400', 'border-neutral-700');
      }
    }

    if (btnToggleSignal) {
      btnToggleSignal.addEventListener('click', () => {
        if (isAudioPlaying) {
          stopAudio();
        } else {
          initAudio();
        }
      });
    }

    // UX Safety: intersection observer to turn off audio when scrolled out
    if (statSection) {
      const audioObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting && isAudioPlaying) {
            stopAudio();
          }
        });
      }, { threshold: 0 });
      audioObserver.observe(statSection);
    }

    // Initialize oscilloscope drawing on mount
    updateOscilloscope();

    // 9. WebGL 3D Globe with Three.js (Lazy Loaded)
    const audienceSection = document.getElementById('audience');
    const globeCanvas = document.getElementById('globe-3d-canvas') as HTMLCanvasElement;
    let globeLoaded = false;

    function init3DGlobe(THREE: any) {
      if (!globeCanvas) return;

      const container = document.getElementById('globe-3d-container');
      if (!container) return;

      const width = container.clientWidth || 384;
      const height = container.clientHeight || 384;

      // Scene, Camera, WebGLRenderer Setup
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
      camera.position.z = 150;

      const renderer = new THREE.WebGLRenderer({
        canvas: globeCanvas,
        alpha: true,
        antialias: true
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(width, height);

      // Create a master group to hold the globe, nodes, and curves
      const globeGroup = new THREE.Group();
      scene.add(globeGroup);

      // Earth sphere wireframe
      const sphereRadius = 45;
      const sphereGeo = new THREE.SphereGeometry(sphereRadius, 30, 30);
      const sphereMat = new THREE.MeshBasicMaterial({
        color: 0x0891b2, // cyan-600
        wireframe: true,
        transparent: true,
        opacity: 0.12
      });
      const sphereMesh = new THREE.Mesh(sphereGeo, sphereMat);
      globeGroup.add(sphereMesh);

      // Inner sphere for volume
      const innerSphereGeo = new THREE.SphereGeometry(sphereRadius - 0.5, 16, 16);
      const innerSphereMat = new THREE.MeshBasicMaterial({
        color: 0x06b6d4,
        transparent: true,
        opacity: 0.03
      });
      const innerSphereMesh = new THREE.Mesh(innerSphereGeo, innerSphereMat);
      globeGroup.add(innerSphereMesh);

      // Lat/Lon to Vector3 conversion
      function latLonToVector3(lat: number, lon: number, radius: number) {
        const phi = (90 - lat) * (Math.PI / 180);
        const theta = (lon + 180) * (Math.PI / 180);

        const x = -(radius * Math.sin(phi) * Math.sin(theta));
        const y = radius * Math.cos(phi);
        const z = radius * Math.sin(phi) * Math.cos(theta);

        return new THREE.Vector3(x, y, z);
      }

      const cities = [
        { name: 'Jakarta', lat: -6.2088, lon: 106.8456 },
        { name: 'Bandung', lat: -6.9175, lon: 107.6191 },
        { name: 'Kyoto', lat: 35.0116, lon: 135.7681 },
        { name: 'Geneva', lat: 46.2044, lon: 6.1432 }
      ];

      const nodeGroup = new THREE.Group();
      globeGroup.add(nodeGroup);

      const nodePositions: any[] = [];
      const nodeMats: any[] = [];

      cities.forEach(city => {
        const pos = latLonToVector3(city.lat, city.lon, sphereRadius);
        nodePositions.push({ name: city.name, pos });

        // Small solid core
        const nodeCoreGeo = new THREE.SphereGeometry(1.2, 8, 8);
        const nodeCoreMat = new THREE.MeshBasicMaterial({
          color: 0x22d3ee, // cyan-400 glowing
          transparent: true,
          opacity: 0.9
        });
        const nodeCore = new THREE.Mesh(nodeCoreGeo, nodeCoreMat);
        nodeCore.position.copy(pos);
        nodeGroup.add(nodeCore);

        // Glow ring
        const nodeGlowGeo = new THREE.SphereGeometry(2.2, 8, 8);
        const nodeGlowMat = new THREE.MeshBasicMaterial({
          color: 0x06b6d4, // cyan-500
          transparent: true,
          opacity: 0.3
        });
        const nodeGlow = new THREE.Mesh(nodeGlowGeo, nodeGlowMat);
        nodeGlow.position.copy(pos);
        nodeGroup.add(nodeGlow);

        nodeMats.push({ core: nodeCoreMat, glow: nodeGlowMat });
      });

      // Glowing connection arcs
      function createConnectionArc(p1: any, p2: any) {
        const distance = p1.distanceTo(p2);
        const midPoint = new THREE.Vector3().addVectors(p1, p2).multiplyScalar(0.5);
        const extrudeHeight = sphereRadius + (distance * 0.25);
        midPoint.normalize().multiplyScalar(extrudeHeight);

        const curve = new THREE.QuadraticBezierCurve3(p1, midPoint, p2);
        const curvePoints = curve.getPoints(40);

        const curveGeo = new THREE.BufferGeometry().setFromPoints(curvePoints);
        const curveMat = new THREE.LineBasicMaterial({
          color: 0x06b6d4,
          transparent: true,
          opacity: 0.5
        });

        const line = new THREE.Line(curveGeo, curveMat);
        globeGroup.add(line);
      }

      // Connect Jakarta to other cities
      const jkt = nodePositions.find(n => n.name === 'Jakarta');
      if (jkt) {
        nodePositions.forEach(cityNode => {
          if (cityNode.name !== 'Jakarta') {
            createConnectionArc(jkt.pos, cityNode.pos);
          }
        });
      }

      // Connect Geneva and Kyoto
      const geneva = nodePositions.find(n => n.name === 'Geneva');
      const kyoto = nodePositions.find(n => n.name === 'Kyoto');
      if (geneva && kyoto) {
        createConnectionArc(geneva.pos, kyoto.pos);
      }

      // Mouse drag controls with LERP inertia
      let isDragging = false;
      let previousPointerPosition = { x: 0, y: 0 };
      let targetRotationX = 0.2;
      let targetRotationY = 0;

      globeGroup.rotation.x = targetRotationX;
      globeGroup.rotation.y = targetRotationY;

      globeCanvas.addEventListener('pointerdown', (e) => {
        isDragging = true;
        previousPointerPosition = { x: e.clientX, y: e.clientY };
        try {
          globeCanvas.setPointerCapture(e.pointerId);
        } catch (err) {}
      });

      globeCanvas.addEventListener('pointermove', (e) => {
        if (!isDragging) return;

        const deltaMove = {
          x: e.clientX - previousPointerPosition.x,
          y: e.clientY - previousPointerPosition.y
        };

        targetRotationY += deltaMove.x * 0.006;
        targetRotationX += deltaMove.y * 0.006;

        previousPointerPosition = { x: e.clientX, y: e.clientY };
      });

      const handlePointerUp = (e: PointerEvent) => {
        isDragging = false;
        try {
          globeCanvas.releasePointerCapture(e.pointerId);
        } catch (err) {}
      };

      globeCanvas.addEventListener('pointerup', handlePointerUp);
      globeCanvas.addEventListener('pointercancel', handlePointerUp);

      globeCanvas.addEventListener('mouseenter', () => {
        if (cursorCircle) cursorCircle.classList.add('cursor-hover');
      });
      globeCanvas.addEventListener('mouseleave', () => {
        if (cursorCircle) cursorCircle.classList.remove('cursor-hover');
        isDragging = false;
      });

      // Animation Loop
      let animFrameId: number;
      const clock = new THREE.Clock();

      function animate() {
        const time = clock.getElapsedTime();

        if (!isDragging) {
          targetRotationY += 0.0018; // Slow rotation auto-orbit
        }

        // Clamp vertical slant
        targetRotationX = Math.max(-Math.PI / 3, Math.min(Math.PI / 3, targetRotationX));

        // LERP rotations
        globeGroup.rotation.y = lerp(globeGroup.rotation.y, targetRotationY, 0.08);
        globeGroup.rotation.x = lerp(globeGroup.rotation.x, targetRotationX, 0.08);

        // Glow nodes pulse
        nodeMats.forEach((mat, idx) => {
          const pulse = 0.5 + 0.4 * Math.sin(time * 4.5 + idx);
          mat.core.opacity = 0.6 + 0.4 * pulse;
          mat.glow.opacity = 0.1 + 0.35 * pulse;
        });

        renderer.render(scene, camera);
        animFrameId = requestAnimationFrame(animate);
      }

      animate();

      // Responsiveness
      const resizeObserver = new ResizeObserver((entries) => {
        for (let entry of entries) {
          const w = entry.contentRect.width || width;
          const h = entry.contentRect.height || height;
          
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        }
      });

      resizeObserver.observe(container);

      return () => {
        cancelAnimationFrame(animFrameId);
        resizeObserver.disconnect();
        renderer.dispose();
      };
    }

    // Lazy load IntersectionObserver
    if (audienceSection && globeCanvas) {
      const globeObserver = new IntersectionObserver((entries) => {
        entries.forEach(async (entry) => {
          if (entry.isIntersecting && !globeLoaded) {
            globeLoaded = true;
            globeObserver.unobserve(audienceSection);

            try {
              const THREE = await import('three');
              init3DGlobe(THREE);
            } catch (err) {
              console.error('Failed to dynamic import Three.js', err);
            }
          }
        });
      }, { rootMargin: '200px' });

      globeObserver.observe(audienceSection);
    }

    // --- Advanced Parallax, 3D Tilt & Velocity Modulation Logic ---

    // 1. Check for reduced motion and touch capability
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 1024px)').matches;

    if (!prefersReducedMotion) {
      // 2. Hero Mouse dual-axis parallax setup variables
      const heroSection = document.getElementById('hero-section');
      const heroGrid = document.getElementById('hero-grid');
      const heroBlueprintLeft = document.getElementById('hero-blueprint-left');
      const heroBlueprintRight = document.getElementById('hero-blueprint-right');

      let heroTargetMX = 0, heroTargetMY = 0;
      let heroCurrentMX = 0, heroCurrentMY = 0;

      if (isDesktop && heroSection) {
        heroSection.addEventListener('mousemove', (e) => {
          const rect = heroSection.getBoundingClientRect();
          heroTargetMX = (e.clientX - rect.left) / rect.width - 0.5;
          heroTargetMY = (e.clientY - rect.top) / rect.height - 0.5;
        });

        heroSection.addEventListener('mouseleave', () => {
          heroTargetMX = 0;
          heroTargetMY = 0;
        });
      }

      // 3. Why Section scroll drawing setup
      const whySection = document.getElementById('why');
      const whyFlowchart = document.getElementById('why-flowchart');
      const whySwarm = document.getElementById('why-swarm');
      const whyPath1 = document.getElementById('why-path-1') as SVGPathElement | null;
      const whyPath2 = document.getElementById('why-path-2') as SVGPathElement | null;
      const whyPath3 = document.getElementById('why-path-3') as SVGPathElement | null;

      let whyPath1Len = 0, whyPath2Len = 0, whyPath3Len = 0;
      if (whyPath1) {
        whyPath1Len = whyPath1.getTotalLength();
        whyPath1.style.strokeDasharray = `${whyPath1Len}`;
        whyPath1.style.strokeDashoffset = `${whyPath1Len}`;
      }
      if (whyPath2) {
        whyPath2Len = whyPath2.getTotalLength();
        whyPath2.style.strokeDasharray = `${whyPath2Len}`;
        whyPath2.style.strokeDashoffset = `${whyPath2Len}`;
      }
      if (whyPath3) {
        whyPath3Len = whyPath3.getTotalLength();
        whyPath3.style.strokeDasharray = `${whyPath3Len}`;
        whyPath3.style.strokeDashoffset = `${whyPath3Len}`;
      }

      // Helper function to measure element position ratio inside viewport
      function getSectionScrollRatio(el: HTMLElement) {
        const rect = el.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const sectionHeight = rect.height;
        const entry = viewportHeight;
        const exit = -sectionHeight;
        
        const current = rect.top;
        if (current > entry) return 0;
        if (current < exit) return 1;
        
        return 1 - (current - exit) / (entry - exit);
      }

      // 4. Stat Bar Scroll Velocity setup
      let lastScrollY = window.scrollY;
      let targetVelocityMultiplier = 1.0;
      let currentVelocityMultiplier = 1.0;

      // 5. Projects Bento Grid 3D Tilt setup
      const projectsSection = document.getElementById('projects');
      const projectsBlueprint = document.getElementById('projects-blueprint');
      const standardsSection = document.getElementById('standards');
      const standardsBlueprint = document.getElementById('standards-blueprint');

      if (isDesktop) {
        const bentoCards = document.querySelectorAll('.hover-3d-card');
        bentoCards.forEach((card) => {
          const htmlCard = card as HTMLElement;
          htmlCard.addEventListener('mousemove', (e) => {
            const rect = htmlCard.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const rx = -(y / rect.height - 0.5) * 1.5; // rotation limit 1.5 deg
            const ry = (x / rect.width - 0.5) * 1.5;

            htmlCard.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
          });

          htmlCard.addEventListener('mouseleave', () => {
            htmlCard.style.transform = 'rotateX(0deg) rotateY(0deg)';
          });
        });
      }

      // 6. Vision concentric circles target lens setup
      const visionSection = document.getElementById('vision');
      const visionLens = document.getElementById('vision-lens');
      const visionDiagram = document.getElementById('vision-diagram');

      // 8. Audience Section & Three.js Globe setup
      const audienceSection = document.getElementById('audience');
      const globe3DContainer = document.getElementById('globe-3d-container');

      // 7. CTA gravitative network pull setup
      const ctaMainBtn = document.getElementById('cta-main-btn');
      const ctaNode1 = document.getElementById('cta-node-1');
      const ctaNode2 = document.getElementById('cta-node-2');
      const ctaNode3 = document.getElementById('cta-node-3');
      const ctaNode4 = document.getElementById('cta-node-4');
      const ctaNode5 = document.getElementById('cta-node-5');
      const ctaLine1 = document.getElementById('cta-line-1');
      const ctaLine2 = document.getElementById('cta-line-2');

      if (isDesktop && ctaMainBtn) {
        ctaMainBtn.addEventListener('mouseenter', () => {
          if (ctaNode1) ctaNode1.style.transform = 'translate3d(50px, 15px, 0)';
          if (ctaNode2) ctaNode2.style.transform = 'translate3d(15px, 35px, 0)';
          if (ctaNode3) ctaNode3.style.transform = 'translate3d(-40px, -35px, 0)';
          if (ctaNode4) ctaNode4.style.transform = 'translate3d(-70px, 25px, 0)';
          if (ctaNode5) ctaNode5.style.transform = 'translate3d(80px, -35px, 0)';
          if (ctaLine1) ctaLine1.style.transform = 'scale(0.85) translate3d(50px, 20px, 0)';
          if (ctaLine2) ctaLine2.style.transform = 'scale(0.85) translate3d(-10px, 10px, 0)';
        });

        ctaMainBtn.addEventListener('mouseleave', () => {
          if (ctaNode1) ctaNode1.style.transform = '';
          if (ctaNode2) ctaNode2.style.transform = '';
          if (ctaNode3) ctaNode3.style.transform = '';
          if (ctaNode4) ctaNode4.style.transform = '';
          if (ctaNode5) ctaNode5.style.transform = '';
          if (ctaLine1) ctaLine1.style.transform = '';
          if (ctaLine2) ctaLine2.style.transform = '';
        });
      }

      // Centralized animation tick loop (requestAnimationFrame throttled)
      let lastAnimScrollY = -1;
      let whyScrollRatio = 0;
      let whyTargetRatio = 0;

      function animationTick() {
        if (isDesktop) {
          // Hero Mouse movements LERP inertia
          heroCurrentMX = lerp(heroCurrentMX, heroTargetMX, 0.08);
          heroCurrentMY = lerp(heroCurrentMY, heroTargetMY, 0.08);

          if (heroGrid) {
            heroGrid.style.transform = `translate3d(${heroCurrentMX * -25}px, ${heroCurrentMY * -25}px, 0)`;
          }
          if (heroBlueprintLeft) {
            heroBlueprintLeft.style.transform = `translate3d(${heroCurrentMX * -15}px, ${heroCurrentMY * -15}px, 0) translateY(${Math.sin(Date.now() / 1500) * 8}px)`;
          }
          if (heroBlueprintRight) {
            heroBlueprintRight.style.transform = `translate3d(${heroCurrentMX * -10}px, ${heroCurrentMY * -10}px, 0) translateY(${Math.cos(Date.now() / 2000) * 12}px)`;
          }
        }

        // Scroll velocity wave modulation
        const currentScrollY = window.scrollY;
        const deltaY = currentScrollY - lastScrollY;
        lastScrollY = currentScrollY;

        const velocityFactor = Math.abs(deltaY) * 0.12;
        targetVelocityMultiplier = 1.0 + Math.min(2.5, velocityFactor);
        currentVelocityMultiplier = lerp(currentVelocityMultiplier, targetVelocityMultiplier, 0.08);
        targetVelocityMultiplier = lerp(targetVelocityMultiplier, 1.0, 0.05);

        oscilloscopeVelocityMultiplier = currentVelocityMultiplier;
        if (Math.abs(oscilloscopeVelocityMultiplier - 1.0) > 0.01 || deltaY !== 0) {
          updateOscilloscope();
        }

        // Scroll ratio calculations (Why & Vision sections)
        if (currentScrollY !== lastAnimScrollY) {
          lastAnimScrollY = currentScrollY;

          // Why section scrub-drawing & vertical parallax
          if (whySection) {
            whyTargetRatio = getSectionScrollRatio(whySection);
            whyScrollRatio = lerp(whyScrollRatio, whyTargetRatio, 0.1);

            if (whyFlowchart) {
              whyFlowchart.style.transform = `translate3d(0, ${(whyScrollRatio - 0.5) * 130}px, 0)`;
            }
            if (whySwarm) {
              whySwarm.style.transform = `translate3d(0, ${(whyScrollRatio - 0.5) * -110}px, 0)`;
            }

            const drawRatio = Math.max(0, Math.min(1, (whyScrollRatio - 0.15) / 0.5));
            if (whyPath1) {
              whyPath1.style.strokeDashoffset = `${whyPath1Len * (1 - drawRatio)}`;
            }
            if (whyPath2) {
              whyPath2.style.strokeDashoffset = `${whyPath2Len * (1 - drawRatio)}`;
            }
            if (whyPath3) {
              whyPath3.style.strokeDashoffset = `${whyPath3Len * (1 - drawRatio)}`;
            }
          }

          // Projects section vertical parallax
          if (projectsSection && projectsBlueprint) {
            const projectsRatio = getSectionScrollRatio(projectsSection);
            projectsBlueprint.style.transform = `translate3d(0, ${(projectsRatio - 0.5) * -165}px, 0)`;
          }

          // Standards section vertical parallax
          if (standardsSection && standardsBlueprint) {
            const standardsRatio = getSectionScrollRatio(standardsSection);
            standardsBlueprint.style.transform = `translate3d(0, ${(standardsRatio - 0.5) * -150}px, 0)`;
          }

          // Vision section focus lens zoom
          if (visionSection) {
            const visionRatio = getSectionScrollRatio(visionSection);
            const focusFactor = Math.max(0, 1.0 - Math.abs(visionRatio - 0.5) * 2);

            if (visionLens) {
              visionLens.style.transform = `scale(${1.0 + focusFactor * 0.08}) translate3d(0, ${(visionRatio - 0.5) * -120}px, 0)`;
            }
            if (visionDiagram) {
              visionDiagram.style.transform = `scale(${1.0 + focusFactor * 0.05}) translate3d(0, ${(visionRatio - 0.5) * 90}px, 0)`;
            }
          }

          // Audience section 3D Globe vertical parallax (with vertical centering offset)
          if (audienceSection && globe3DContainer) {
            const audienceRatio = getSectionScrollRatio(audienceSection);
            globe3DContainer.style.transform = `translate3d(-50%, calc(-50% + ${(audienceRatio - 0.5) * -125}px), 0)`;
          }
        }

        requestAnimationFrame(animationTick);
      }

      // Launch loop
      requestAnimationFrame(animationTick);
    }

    // --- Mobile Collapsible Accordion Sections ---
    const collapsibles = [
      {
        btnId: 'why-toggle-btn',
        collapseId: 'why-collapse',
        secId: 'why',
        expandText: '[ BUKA PERBANDINGAN / EXPAND COMPARISON ]',
        collapseText: '[ TUTUP PERBANDINGAN / COLLAPSE COMPARISON ]'
      },
      {
        btnId: 'projects-toggle-btn',
        collapseId: 'projects-collapse',
        secId: 'projects',
        expandText: '[ BUKA PROYEK / EXPAND PROJECTS ]',
        collapseText: '[ TUTUP PROYEK / COLLAPSE PROJECTS ]'
      }
    ];

    collapsibles.forEach(cfg => {
      const btn = document.getElementById(cfg.btnId);
      const collapse = document.getElementById(cfg.collapseId);
      const section = document.getElementById(cfg.secId);
      if (!btn || !collapse) return;

      btn.addEventListener('click', () => {
        const isExpanded = collapse.classList.contains('expanded');
        
        if (isExpanded) {
          // Collapse
          collapse.classList.remove('expanded');
          const btnText = btn.querySelector('.btn-text');
          const btnIcon = btn.querySelector('.btn-icon') as HTMLElement | null;
          if (btnText) btnText.textContent = cfg.expandText;
          if (btnIcon) {
            btnIcon.textContent = '+';
            btnIcon.style.transform = 'rotate(0deg)';
          }
          // Smooth scroll back to section header so user isn't lost
          if (section) {
            section.scrollIntoView({ behavior: 'smooth' });
          }
        } else {
          // Expand
          collapse.classList.add('expanded');
          const btnText = btn.querySelector('.btn-text');
          const btnIcon = btn.querySelector('.btn-icon') as HTMLElement | null;
          if (btnText) btnText.textContent = cfg.collapseText;
          if (btnIcon) {
            btnIcon.textContent = '−'; // minus sign
            btnIcon.style.transform = 'rotate(180deg)';
          }
        }
      });
    });

    // --- Mobile Horizontal Swipe Carousel Dot Sync ---
    const carousels = [
      {
        carouselId: 'why-carousel',
        dotsId: 'why-carousel-dots'
      },
      {
        carouselId: 'products-carousel',
        dotsId: 'products-carousel-dots'
      },
      {
        carouselId: 'standards-carousel',
        dotsId: 'standards-carousel-dots'
      },
      {
        carouselId: 'audience-carousel',
        dotsId: 'audience-carousel-dots'
      }
    ];

    carousels.forEach(cfg => {
      const container = document.getElementById(cfg.carouselId);
      const dotsContainer = document.getElementById(cfg.dotsId);
      if (!container || !dotsContainer) return;

      const dots = dotsContainer.querySelectorAll('span');

      // Handle Scroll sync
      let carouselScrollTimeout: number | undefined;
      container.addEventListener('scroll', () => {
        if (carouselScrollTimeout) window.cancelAnimationFrame(carouselScrollTimeout);
        carouselScrollTimeout = window.requestAnimationFrame(() => {
          const card = container.firstElementChild as HTMLElement | null;
          if (!card) return;

          const cardWidth = card.getBoundingClientRect().width;
          const gap = parseFloat(window.getComputedStyle(container).gap) || 0;
          const activeIndex = Math.round(container.scrollLeft / (cardWidth + gap));
          
          dots.forEach((dot, idx) => {
            if (idx === activeIndex) {
              dot.className = 'w-3 h-1.5 rounded-full bg-brand-600 transition-all duration-300';
            } else {
              dot.className = 'w-1.5 h-1.5 rounded-full bg-neutral-300 transition-all duration-300';
            }
          });
        });
      }, { passive: true });

      // Handle Click dots to scroll
      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          const idxAttr = dot.getAttribute('data-index');
          if (idxAttr === null) return;
          const idx = parseInt(idxAttr);
          const card = container.firstElementChild as HTMLElement | null;
          if (!card) return;

          const cardWidth = card.getBoundingClientRect().width;
          const gap = parseFloat(window.getComputedStyle(container).gap) || 0;

          container.scrollTo({
            left: idx * (cardWidth + gap),
            behavior: 'smooth'
          });
        });
      });
    });

    // --- Mobile Floating Quick-Jump Dock ---
    const quickDock = document.getElementById('mobile-quick-dock');
    if (quickDock) {
      const dockItems = quickDock.querySelectorAll('.dock-item');
      
      const updateDockState = () => {
        const scrollY = window.scrollY;
        const viewportHeight = window.innerHeight;
        const totalHeight = document.documentElement.scrollHeight;
        
        // Footer threshold
        const isNearFooter = (scrollY + viewportHeight) >= (totalHeight - 160);
        const isNearHero = scrollY < 200;
        
        if (isNearHero || isNearFooter) {
          quickDock.classList.add('dock-hidden');
        } else {
          quickDock.classList.remove('dock-hidden');
        }
      };

      const sectionsConfig = [
        { id: 'why', navId: 'why' },
        { id: 'projects', navId: 'projects' },
        { id: 'standards', navId: 'standards' },
        { id: 'vision', navId: 'vision' },
        { id: 'audience', navId: 'audience' }
      ];

      const updateActiveDockItem = () => {
        const targetLine = window.innerHeight / 2; // middle of viewport is very reliable for quick-dock
        let activeNavId: string | null = null;

        for (const section of sectionsConfig) {
          const el = document.getElementById(section.id);
          if (el) {
            const rect = el.getBoundingClientRect();
            if (rect.top <= targetLine && rect.bottom >= targetLine) {
              activeNavId = section.navId;
              break;
            }
          }
        }

        // Fallback: Closest section if none matches exactly
        if (!activeNavId) {
          let minDistance = Infinity;
          for (const section of sectionsConfig) {
            const el = document.getElementById(section.id);
            if (el) {
              const rect = el.getBoundingClientRect();
              const distance = Math.abs(rect.top - targetLine);
              if (distance < minDistance) {
                minDistance = distance;
                activeNavId = section.navId;
              }
            }
          }
        }

        dockItems.forEach(item => {
          const itemSection = item.getAttribute('data-section');
          item.classList.toggle('active', itemSection === activeNavId);
        });
      };

      let dockScrollTimeout: number | undefined;
      window.addEventListener('scroll', () => {
        updateDockState();
        
        if (dockScrollTimeout) window.cancelAnimationFrame(dockScrollTimeout);
        dockScrollTimeout = window.requestAnimationFrame(() => {
          updateActiveDockItem();
        });
      }, { passive: true });

      // Initial check
      updateDockState();
      updateActiveDockItem();

      // Smooth click handling
      dockItems.forEach(item => {
        item.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = item.getAttribute('href');
          if (!targetId) return;
          const targetEl = document.querySelector(targetId);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });
    }
  </script>

