---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-stone-900 mb-4">
      OpenRiset
    </h1>
    <p class="text-xl text-stone-600 mb-8">
      Infrastruktur Sains Terbuka untuk Indonesia
    </p>
    <p class="text-stone-700">
      OpenRiset adalah organisasi yang membangun infrastruktur saintifik terbuka. 
      Platform untuk mengindeks, memverifikasi, dan mempublikasikan karya ilmiah.
    </p>
  </main>
</Layout>
